generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id              String       @id @default(uuid())
  name            String
  legalName       String?
  address         String?
  phone           String?
  email           String?
  website         String?
  timezone        String       @default("UTC")
  currency        String       @default("USD")
  defaultLanguage String       @default("en")
  slug            String // Phase 1b: NOT NULL — @@unique([organizationId, slug]) added below
  status          String       @default("trial") // trial | active | suspended | cancelled
  trialEndsAt     DateTime?
  maxUsers        Int          @default(10) // Kept for backwards compat; plan limits read from Organization after migration
  maxPatients     Int          @default(500) // Kept for backwards compat
  planId          String? // Staged migration: kept until Organization.planId is validated
  plan            Plan?        @relation(fields: [planId], references: [id])
  organizationId  String // Phase 1b: NOT NULL after backfill
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users                         User[]
  doctorAvailabilities          DoctorAvailability[]
  doctorOffDays                 DoctorOffDay[]
  patients                      Patient[]
  appointmentTypes              AppointmentType[]
  appointments                  Appointment[]
  appointmentRequests           AppointmentRequest[]
  contactRequests               ContactRequest[]
  treatmentCases                TreatmentCase[]
  tasks                         Task[]
  payments                      Payment[]
  insuranceProvisions           InsuranceProvision[]
  messageTemplates              MessageTemplate[]
  sentMessages                  SentMessage[]
  activityLogs                  ActivityLog[]
  whatsappConversationStates    WhatsAppConversationState[]
  whatsappConversationMessages  WhatsAppConversationMessage[]
  settings                      Setting[]
  recallSetting                 ClinicRecallSetting?
  recallCandidates              RecallCandidate[]
  recallActions                 RecallAction[]
  patientAttachments            PatientAttachment[]
  toothRecords                  ToothRecord[]
  paymentPlans                  PaymentPlan[]
  practitionerCompRules         PractitionerCompensationRule[]
  serviceCompRules              ServiceCompensationRule[]
  practitionerEarnings          PractitionerEarning[]
  practitionerPayouts           PractitionerPayout[]
  inventoryItems                InventoryItem[]
  inventoryTransactions         InventoryTransaction[]
  inventoryUnits                InventoryUnit[]
  treatmentPlanProcedures       TreatmentPlanProcedure[]
  treatmentPackages             TreatmentPackage[]
  treatmentPackageItems         TreatmentPackageItem[]
  appointmentTypeMaterials      AppointmentTypeMaterial[]
  treatmentPackageMaterials     TreatmentPackageMaterial[]
  treatmentPackageApplications  TreatmentPackageApplication[]
  notifications                 Notification[]
  invitations                   ClinicInvitation[]
  defaultUsers                  User[]                             @relation("UserDefaultClinic")
  primaryPatients               Patient[]                          @relation("PatientPrimaryClinic")
  userClinics                   UserClinic[]
  patientClinics                PatientClinic[]
  clinicWorkingHours            ClinicWorkingHours[]
  clinicWhatsAppConnections     ClinicWhatsAppConnection[]
  whatsappInboxEntries          WhatsAppInboxEntry[]               @relation("InboxEntryClinic")
  clinicInstagramConnections    ClinicInstagramConnection[]
  instagramInboxEntries         InstagramInboxEntry[]              @relation("InstagramInboxEntryClinic")
  instagramConversationMessages InstagramConversationMessage[]
  postTreatmentTemplates        PostTreatmentMessageTemplate[]
  postTreatmentQueue            PostTreatmentMessageQueue[]
  patientPrivacyRequests        PatientPrivacyRequest[]
  clinicLegalProfile            ClinicLegalProfile?
  channelConsentLogs            ChannelConsentLog[]
  smsSettings                   ClinicSmsSettings?
  smsMessages                   SmsMessage[]
  smsUsageCounters              SmsUsageCounter[]
  laboratories                  Laboratory[]
  labWorkOrders                 LabWorkOrder[]
  labOrderAttachments           LabOrderAttachment[]
  imagingDevices                ImagingDevice[]
  imagingRequests               ImagingRequest[]
  imagingStudies                ImagingStudy[]
  imagingImages                 ImagingImage[]
  imagingBridgeAgents           ImagingBridgeAgent[]
  imagingBridgePairings         ImagingBridgePairing[]
  imagingBridgeBindings         ImagingBridgeBinding[]
  publicBookingNoticeEvidences  PublicBookingNoticeEvidence[]
  privacyExportArchives         PatientPrivacyExportArchive[]
  clinicBulkExportArchives      ClinicBulkExportArchive[]
  clinicBulkExportPwAttempts    ClinicBulkExportPasswordAttempt[]
  communicationPreferences      PatientCommunicationPreference[]
  communicationConsentEvents    PatientCommunicationConsentEvent[]
  legacyConsentCorrections      PatientLegacyConsentCorrection[]
  externalCalendarIntegration   ExternalCalendarIntegration?
  patientEmergencyContacts      PatientEmergencyContact[]
  patientMedicalHistories       PatientMedicalHistory[]
  patientConditions             PatientCondition[]
  // F3-DATA-MIG-TODAY-001 — Platform Admin clinic data migration back-relations.
  migrationRuns                 MigrationRun[]                     @relation("MigrationRunClinic")
  migrationRecords              MigrationRecord[]                  @relation("MigrationRecordClinic")
  migrationReferenceMaps        MigrationReferenceMap[]            @relation("MigrationReferenceMapClinic")
  patientIdentityDocuments      PatientIdentityDocument[]          @relation("PatientIdentityDocumentClinic")
  // F3-DATA-MIG-TODAY-001-R10 back-relations.
  patientContactPoints          PatientContactPoint[]              @relation("PatientContactPointClinic")
  migrationPreservedValues      MigrationPreservedSourceValue[]    @relation("MigrationPreservedSourceValueClinic")

  @@unique([organizationId, slug])
}

model User {
  id                  String       @id @default(uuid())
  clinicId            String
  clinic              Clinic       @relation(fields: [clinicId], references: [id])
  firstName           String
  lastName            String
  email               String
  phone               String?
  role                String // OWNER | ORG_ADMIN | CLINIC_MANAGER | DENTIST | RECEPTIONIST | BILLING | ASSISTANT
  passwordHash        String
  /// JWTs issued before this moment are rejected — set on every password change/reset
  passwordChangedAt   DateTime?
  isActive            Boolean      @default(true)
  lastLoginAt         DateTime?
  commissionRate      Float        @default(0)
  emailVerifiedAt     DateTime?
  organizationId      String // Phase 1b: NOT NULL after backfill
  organization        Organization @relation(fields: [organizationId], references: [id])
  defaultClinicId     String? // UI default only — NOT used for authorization
  defaultClinic       Clinic?      @relation("UserDefaultClinic", fields: [defaultClinicId], references: [id])
  canAccessAllClinics Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tasksCreated                    Task[]                           @relation("TaskCreator")
  tasksAssigned                   Task[]                           @relation("TaskAssignee")
  appointments                    Appointment[]                    @relation("Practitioner")
  appointmentRequests             AppointmentRequest[]             @relation("AppointmentRequestPractitioner")
  contactRequestsAssigned         ContactRequest[]                 @relation("ContactRequestAssignee")
  contactRequestsResolved         ContactRequest[]                 @relation("ContactRequestResolver")
  availabilities                  DoctorAvailability[]             @relation("DoctorAvailability")
  offDays                         DoctorOffDay[]                   @relation("DoctorOffDays")
  treatmentCases                  TreatmentCase[]                  @relation("Practitioner")
  insuranceAssigned               InsuranceProvision[]             @relation("InsuranceAssignedTo")
  insuranceCreated                InsuranceProvision[]             @relation("InsuranceCreatedBy")
  sentMessages                    SentMessage[]
  createdTemplates                MessageTemplate[]                @relation("TemplateCreator")
  activityLogs                    ActivityLog[]
  uploadedAttachments             PatientAttachment[]              @relation("AttachmentUploader")
  privacyExportsRequested         PatientPrivacyExportArchive[]    @relation("PrivacyExportRequester")
  clinicBulkExportsRequested      ClinicBulkExportArchive[]        @relation("ClinicBulkExportRequester")
  clinicBulkExportsStepUpVerified ClinicBulkExportArchive[]        @relation("ClinicBulkExportStepUpVerifier")
  toothRecordsCreated             ToothRecord[]                    @relation("ToothRecordCreator")
  paymentPlans                    PaymentPlan[]
  compensationRules               PractitionerCompensationRule[]   @relation("PractitionerCompRules")
  serviceCompRules                ServiceCompensationRule[]        @relation("ServiceCompRules")
  practitionerEarnings            PractitionerEarning[]            @relation("PractitionerEarnings")
  practitionerPayouts             PractitionerPayout[]             @relation("PractitionerPayouts")
  payoutsCreated                  PractitionerPayout[]             @relation("PayoutCreator")
  inventoryTransactions           InventoryTransaction[]           @relation("InventoryPerformedBy")
  proceduresCreated               TreatmentPlanProcedure[]         @relation("ProcedureCreator")
  packageApplicationsCreated      TreatmentPackageApplication[]    @relation("TreatmentPackageApplicationCreator")
  userClinics                     UserClinic[]
  resolvedInboxEntries            WhatsAppInboxEntry[]             @relation("InboxEntryResolver")
  resolvedInstagramEntries        InstagramInboxEntry[]            @relation("InstagramInboxEntryResolver")
  assignedRecallCandidates        RecallCandidate[]                @relation("RecallCandidateAssignee")
  performedRecallActions          RecallAction[]                   @relation("RecallActionPerformer")
  passwordResetTokens             PasswordResetToken[]
  emailVerificationTokens         EmailVerificationToken[]
  smsMessagesCreated              SmsMessage[]                     @relation("SmsMessageCreator")
  laboratoriesCreated             Laboratory[]                     @relation("LaboratoryCreator")
  labWorkOrdersCreated            LabWorkOrder[]                   @relation("LabWorkOrderCreator")
  labWorkOrdersAsPractitioner     LabWorkOrder[]                   @relation("LabWorkOrderPractitioner")
  labWorkOrderStatusChanges       LabWorkOrderStatusHistory[]      @relation("LabWorkOrderStatusChanger")
  labOrderAttachmentsUploaded     LabOrderAttachment[]             @relation("LabOrderAttachmentUploader")
  imagingDevicesCreated           ImagingDevice[]                  @relation("ImagingDeviceCreator")
  imagingRequestsRequested        ImagingRequest[]                 @relation("ImagingRequestRequester")
  imagingStudiesCreated           ImagingStudy[]                   @relation("ImagingStudyCreator")
  imagingBridgeAgentsCreated      ImagingBridgeAgent[]             @relation("ImagingBridgeAgentCreator")
  imagingBridgePairingsCreated    ImagingBridgePairing[]           @relation("ImagingBridgePairingCreator")
  legacyConsentCorrections        PatientLegacyConsentCorrection[]
  medicalHistoryRecorded          PatientMedicalHistory[]          @relation("MedicalHistoryRecorder")
  /// F3-DATA-MIG-TODAY-001 (G-E3) back-relation. A migration never creates a
  /// User; it only resolves an existing one through MigrationReferenceMap.
  patientsAsPrimaryPractitioner   Patient[]                        @relation("PatientPrimaryPractitioner")

  // Global uniqueness on lower(email) is enforced by a raw DB index (migration 20260629120000).
}

model DoctorAvailability {
  id             String   @id @default(uuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  practitionerId String
  practitioner   User     @relation("DoctorAvailability", fields: [practitionerId], references: [id])
  weekday        Int // 0 Sunday, 1 Monday, ... 6 Saturday
  startTime      String // HH:mm
  endTime        String // HH:mm
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clinicId, practitionerId, weekday])
}

model DoctorOffDay {
  id             String   @id @default(uuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  practitionerId String
  practitioner   User     @relation("DoctorOffDays", fields: [practitionerId], references: [id])
  date           String // YYYY-MM-DD (clinic local date)
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clinicId, practitionerId, date])
  @@index([clinicId, practitionerId])
}

model Patient {
  id                    String       @id @default(uuid())
  clinicId              String
  clinic                Clinic       @relation(fields: [clinicId], references: [id])
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  address               String?
  /// Province / il. NOT renamed by R10, deliberately. This column has carried
  /// province semantics since before the migration program existed — the
  /// destination catalog labels it "City / province" (contracts.ts) and the
  /// first-customer matrix maps source `IL` (province) onto it. Renaming it to
  /// `province` would need a data migration, an API compatibility shim and a
  /// catalog change, for no behaviour gain; the patient UI simply LABELS it
  /// "Province / İl". See `district` below for the half that was missing.
  city                  String?
  postalCode            String?
  country               String?
  /// F3-DATA-MIG-TODAY-001-R10. District / ilçe — the one structurally missing
  /// piece of a Turkish address. Additive, nullable, no default, no backfill.
  ///
  /// Before R10 a Turkish address could not be recorded properly at all: the
  /// product had address/city/postalCode/country but no district, and the
  /// first-customer matrix had to hold source `ILCE` at MANUAL_REVIEW with the
  /// note "No district field exists, so a human decides whether that matters;
  /// the system may not decide it by omission." This column closes that.
  ///
  /// Deliberately NOT folded into `address`: composition order would then
  /// depend on fill rate, which breaks rerun stability (the same reason
  /// MAHALLE/ADRESI compose in a FIXED order).
  ///
  /// String?, not a Prisma enum, and no @default — a native enum column would
  /// be invisible to migrationPatientSchemaDrift.ts's PRISMA_SCALAR_TYPES
  /// filter forever. Same reasoning as `gender` and `bloodGroup`.
  district              String?
  patientStatus         String       @default("new") // new, active, inactive, archived
  source                String? // google, referral, social_media, etc.
  notes                 String?
  /// F3-DATA-MIG-TODAY-001 (G-E5). Additive, nullable, no default, zero
  /// backfill. Allowed values: male | female | other — the vocabulary the
  /// product already publishes to customers in the basic import template
  /// (utils/excelImport.ts:55). NULL means "not recorded / never asked" and is
  /// a DISTINCT state from 'other', which is an affirmative, patient-reported
  /// value. A blank or unrecognized legacy source value maps to NULL and a
  /// row warning — NEVER to 'other', and never to a guessed male/female.
  /// Not a Prisma enum, per the repo-wide String + doc-comment convention.
  /// Nulled by anonymization (services/privacy/patientAnonymization.ts).
  gender                String?
  /// F3-DATA-MIG-TODAY-001 (G-E6). Legacy clinic-facing chart / file number
  /// (source DOSYANO — the number reception staff quote and that is written on
  /// every paper chart). Additive, nullable, zero backfill.
  /// DELIBERATELY NOT UNIQUE: measured source evidence carries 17 duplicate
  /// pairs (34 of 14,718 filled rows, 0.23 %) that require manual
  /// reconciliation — a hard unique constraint would block go-live before any
  /// human reviewed them. Duplicates are surfaced for manual review, never
  /// silently overwritten. Indexed tenant-first as @@index([clinicId,
  /// chartNumber]).
  /// Re-identification vector against the physical archive — nulled by
  /// anonymization.
  chartNumber           String?
  /// F3-DATA-MIG-TODAY-001-R8. Structured ABO/Rh blood group (source
  /// KANGURUBU). Additive, nullable, no default, zero backfill.
  ///
  /// Closed vocabulary, and the ONLY accepted values:
  ///   A_POSITIVE  A_NEGATIVE  B_POSITIVE  B_NEGATIVE
  ///   AB_POSITIVE AB_NEGATIVE O_POSITIVE  O_NEGATIVE
  /// Declared in ONE place, `patientBloodGroupValues` (src/schemas/index.ts),
  /// which the write schema, the migration destination catalog and the UI all
  /// validate against.
  ///
  /// THERE IS DELIBERATELY NO `UNKNOWN` MEMBER. NULL means "no blood group is
  /// recorded", and an UNKNOWN token would be indistinguishable from a
  /// recorded fact that the patient's group is unknown — a clinically
  /// different claim. A malformed or unrecognized legacy value therefore maps
  /// to NULL plus a row warning, never to a placeholder and never to a guess:
  /// Rh is NEVER inferred when the source omits it (see `blood_group_tr` in
  /// services/migration/mapping/transforms.ts).
  ///
  /// Canonical storage is the letter O, never the digit 0. Turkish clinical
  /// usage writes the O group as "0 Rh+", so "0" is accepted on INPUT and
  /// rendered as "0 Rh+" in the Turkish UI, but what is stored is O_POSITIVE.
  ///
  /// KVKK Art. 6 SPECIAL-CATEGORY health data. It is a `String?` and not a
  /// Prisma enum on purpose: this repository stores every closed vocabulary
  /// (gender, patientStatus, source, pregnancyStatus) as a documented String,
  /// and — decisively — the permanent drift guard in
  /// tests/migrationPatientSchemaDrift.test.ts enumerates Patient columns by
  /// filtering PRISMA_SCALAR_TYPES. A native enum column would be invisible to
  /// that guard forever, i.e. fail-OPEN on anonymization / subject access /
  /// bulk export for the one field that most needs them.
  /// NOT on PatientMedicalHistory, which is where the field-gap decision
  /// package's G-E11 proposed a `bloodType` (and left DEFERRED, unbuilt).
  /// Two reasons. (1) That model is a VERSIONED clinical record: every row
  /// requires `recordedById` - a real User who took the history - and a
  /// per-patient version allocated under an advisory lock. A migration has
  /// no recording clinician, and naming one would attribute a clinical act
  /// to a staff member who never performed it; the same reasoning already
  /// stops a migration creating a User for primaryPractitionerId.
  /// (2) A blood group is a STABLE patient attribute, not a point-in-time
  /// history entry that is re-taken and superseded, so versioning it would
  /// model it as something it is not. Allergies and current medications DO
  /// belong there, and stay there.
  /// Nulled by anonymization (services/privacy/patientAnonymization.ts).
  bloodGroup            String?
  /// F3-DATA-MIG-TODAY-001 (G-E3). The patient's assigned practitioner
  /// (source HASTADOKTOR, resolved to a real User.id through
  /// MigrationReferenceMap). Additive, nullable, zero backfill.
  /// A migration NEVER creates a User to satisfy this: a migration-created
  /// practitioner would be a credentialed, payable account created without an
  /// onboarding decision. An unresolved source practitioner value blocks the
  /// affected rows instead.
  primaryPractitionerId String?
  primaryPractitioner   User?        @relation("PatientPrimaryPractitioner", fields: [primaryPractitionerId], references: [id])
  communicationConsent  Boolean      @default(false)
  marketingConsent      Boolean      @default(false)
  // SMS opt-out (KVKK/GDPR): blocks all outbound SMS when set.
  // Foundation for future STOP/RET/IPTAL/UNSUBSCRIBE inbound keywords.
  smsOptOut             Boolean      @default(false)
  smsOptOutAt           DateTime?
  organizationId        String // Phase 1b: NOT NULL after backfill
  organization          Organization @relation(fields: [organizationId], references: [id])
  primaryClinicId       String? // Default/preferred branch (not exclusive)
  primaryClinic         Clinic?      @relation("PatientPrimaryClinic", fields: [primaryClinicId], references: [id])
  // KVKK/GDPR anonymization tracking
  isAnonymized          Boolean      @default(false)
  anonymizedAt          DateTime?
  anonymizedById        String?
  anonymizationReason   String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  appointments                  Appointment[]
  appointmentRequests           AppointmentRequest[]
  contactRequests               ContactRequest[]
  treatmentCases                TreatmentCase[]
  tasks                         Task[]
  payments                      Payment[]
  insuranceProvisions           InsuranceProvision[]
  sentMessages                  SentMessage[]
  activityLogs                  ActivityLog[]
  whatsappConversationMessages  WhatsAppConversationMessage[]
  attachments                   PatientAttachment[]
  toothRecords                  ToothRecord[]
  paymentPlans                  PaymentPlan[]
  practitionerEarnings          PractitionerEarning[]
  treatmentPlanProcedures       TreatmentPlanProcedure[]
  treatmentPackageApplications  TreatmentPackageApplication[]
  patientClinics                PatientClinic[]
  whatsappInboxEntries          WhatsAppInboxEntry[]               @relation("InboxEntryPatient")
  instagramInboxEntries         InstagramInboxEntry[]              @relation("InstagramInboxEntryPatient")
  instagramConversationMessages InstagramConversationMessage[]
  postTreatmentQueue            PostTreatmentMessageQueue[]
  recallCandidates              RecallCandidate[]
  recallActions                 RecallAction[]
  privacyRequests               PatientPrivacyRequest[]
  smsMessages                   SmsMessage[]
  labWorkOrders                 LabWorkOrder[]
  imagingRequests               ImagingRequest[]
  imagingStudies                ImagingStudy[]
  communicationPreferences      PatientCommunicationPreference[]
  communicationConsentEvents    PatientCommunicationConsentEvent[]
  legacyConsentCorrections      PatientLegacyConsentCorrection[]
  emergencyContacts             PatientEmergencyContact[]
  medicalHistoryVersions        PatientMedicalHistory[]
  medicalConditionLinks         PatientCondition[]
  /// F3-DATA-MIG-003 / G-E4. Encrypted national/travel identity documents.
  /// Returned ONLY when explicitly included — never by the whole-record spread
  /// at routes/patients.ts:167-191/:273. That is the whole point of the child
  /// model. See PatientIdentityDocument.
  identityDocuments             PatientIdentityDocument[]
  /// F3-DATA-MIG-TODAY-001-R10. Secondary phone numbers (home/work/other).
  /// `Patient.phone` remains THE primary number and the only one any existing
  /// flow reads. See PatientContactPoint.
  contactPoints                 PatientContactPoint[]
  /// F3-DATA-MIG-TODAY-001-R10. Legacy source values preserved verbatim with
  /// provenance because they had no canonical destination. Evidence, never
  /// current clinical truth. See MigrationPreservedSourceValue.
  preservedSourceValues         MigrationPreservedSourceValue[]

  @@index([clinicId, phone])
  @@index([clinicId, email])
  /// F3-DATA-MIG-TODAY-001 (G-E6). Tenant column leads, so the index is usable
  /// under the clinic scope every query already applies.
  @@index([clinicId, chartNumber])
  /// F3-DATA-MIG-TODAY-001 (G-E3).
  @@index([clinicId, primaryPractitionerId])
}

/// US-01.2: patient emergency contacts, relationship (contactType), and legal
/// decision-maker flags (e.g. parent/guardian for a minor patient). Additive,
/// backward-compatible — no existing Patient row requires backfill.
///
/// contactType is a stable backend string contract (not a Prisma enum, per
/// the string-based status/type convention used elsewhere in this schema —
/// see Patient.patientStatus, Appointment.status, etc.): SPOUSE | PARENT |
/// GUARDIAN | CHILD | SIBLING | OTHER.
///
/// At most one row per patient may have isPrimary=true — enforced by a
/// DATABASE-BACKED partial unique index (PatientEmergencyContact_
/// one_primary_per_patient, WHERE isPrimary = true — see migration
/// 20260803120000_add_patient_emergency_contacts), not just the
/// application-layer prisma.$transaction() reset-then-set sequence in
/// server/src/routes/patientEmergencyContacts.ts. The index only ever
/// indexes isPrimary=true rows, so it can still accommodate the "no primary
/// yet" state (any number of isPrimary=false rows) while capping true rows
/// at one. NOTE: this partial index cannot be expressed as `@@unique` here —
/// Prisma's schema DSL has no filtered/partial unique index support, and a
/// plain `@@unique([patientId, isPrimary])` would incorrectly also cap
/// isPrimary=false rows at one per patient. isLegalDecisionMaker is
/// intentionally NOT unique per patient — multiple legal guardians/
/// decision-makers are a valid real-world case.
model PatientEmergencyContact {
  id                   String       @id @default(uuid())
  patientId            String
  patient              Patient      @relation(fields: [patientId], references: [id])
  clinicId             String
  clinic               Clinic       @relation(fields: [clinicId], references: [id])
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  contactType          String // SPOUSE | PARENT | GUARDIAN | CHILD | SIBLING | OTHER
  fullName             String
  phone                String?
  phoneCountryCode     String?
  email                String?
  occupation           String?
  isPrimary            Boolean      @default(false)
  isLegalDecisionMaker Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([patientId, isPrimary])
  @@index([clinicId])
  @@index([organizationId])
}

/// F3-DATA-MIG-TODAY-001-R10 — SECONDARY PATIENT CONTACT POINTS.
///
/// WHY THIS IS NOT PatientEmergencyContact. The legacy export carries
/// `EVTELEFONU` (home phone, 50 measured rows) and `ISTELEFONU` (work phone,
/// 166 measured rows). Both are the PATIENT'S OWN alternative numbers. Routing
/// them into PatientEmergencyContact would fabricate a named third party, a
/// relationship type and — through `isLegalDecisionMaker` — a clinical
/// decision-making authority that nobody in the source data ever asserted.
/// The first-customer matrix records that as a HARD RULE. This model exists so
/// the rule can be obeyed without discarding the numbers.
///
/// WHY IT IS NOT A SECOND COLUMN ON Patient. Phone count is open-ended, and
/// `Patient` is returned by a whole-record spread at routes/patients.ts, so
/// every new scalar auto-leaks to every authorized clinic client. A child
/// model keeps the shape honest and the exposure explicit.
///
/// PRIMARY PHONE IS UNCHANGED AND STAYS ON Patient. `Patient.phone` remains
/// THE primary number: WhatsApp inbound matching, the shared-family-phone
/// behaviour, SMS routing, duplicate detection and `@@index([clinicId, phone])`
/// all continue to read it and ONLY it. Nothing in this model participates in
/// patient matching, and no migration may write a secondary number into
/// `Patient.phone`. Shared-family-phone semantics are therefore untouched:
/// 1,883 numbers are shared across 4,390 rows in the first customer's export,
/// and that behaviour is deliberate product behaviour, not a defect.
///
/// `normalizedValue` is digits-only, stored for display grouping and duplicate
/// hinting WITHIN a patient. It is deliberately NOT unique and deliberately
/// NOT indexed across patients — an inbound-message matcher that started
/// reading it would silently change which patient a message resolves to.
model PatientContactPoint {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  clinicId       String
  clinic         Clinic       @relation("PatientContactPointClinic", fields: [clinicId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// mobile | home | work | other. Plain String with the vocabulary in this
  /// comment, per the schema-wide convention — a native enum would be
  /// invisible to the schema-drift guards.
  contactType     String
  /// The number as entered/imported. Never normalized destructively.
  value           String
  /// Digits-only projection of `value`. Display and within-patient duplicate
  /// hinting ONLY. Never a matching key. See the model note above.
  normalizedValue String?
  /// Optional free-text label ("iş", "yazlık"). Never clinical.
  label           String?
  /// patient_portal | staff | import | api | legacy_migration
  source          String  @default("staff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per (patient, type, number): re-running an import can never
  /// duplicate a contact point, which is what makes migration idempotent here.
  @@unique([patientId, contactType, value])
  @@index([patientId, contactType])
  @@index([clinicId])
  @@index([organizationId])
}

/// US-01.1-P1: versioned medical-history foundation. Medical history is
/// sensitive health data (KVKK/GDPR "special category" equivalent) — see
/// docs/compliance for the general anonymization/export conventions this
/// model follows (server/src/services/privacy/patientAnonymization.ts,
/// server/src/routes/patientPrivacy.ts). Additive, backward-compatible — no
/// existing Patient row requires backfill (zero rows until the first version
/// is recorded via POST /api/patients/:patientId/medical-history).
///
/// Design: EACH ROW IS ONE IMMUTABLE VERSION. Unlike
/// PatientCommunicationPreference/-ConsentEvent, there is no separate
/// mutable "current state" row — a version, once inserted, is never updated
/// or deleted by application code (no PUT/PATCH/DELETE route exists for this
/// resource in P1 — see server/src/routes/patientMedicalHistory.ts). Creating
/// an update always INSERTs a new row with version = previous max(version)+1
/// for that patientId; "latest version" is simply the row with the highest
/// `version` for a given patientId. version allocation is concurrency-safe
/// via a per-patient pg_advisory_xact_lock (see
/// server/src/services/patientMedicalHistoryConcurrency.ts), the same
/// pattern used for PatientEmergencyContact's single-primary invariant.
/// @@unique([patientId, version]) is the database-level backstop that
/// rejects any duplicate pair that slips past the lock — never rely on the
/// lock alone (see that file's header for why an advisory lock, not just a
/// unique index, is required to close the race deterministically).
///
/// noKnownConditions is an exclusive state: when true, this version must
/// have zero linked PatientCondition rows — validated in
/// server/src/services/medicalHistory.ts, never trusted from the client
/// alone. clinicId mirrors Patient.clinicId (the patient's home clinic),
/// consistent with the PatientEmergencyContact tri-scope convention above —
/// not the clinic of whichever appointment prompted the recording.
model PatientMedicalHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  /// Monotonic per-patient version counter starting at 1. Allocated under a
  /// per-patient pg_advisory_xact_lock inside the create transaction — never
  /// trust a client-supplied value.
  version Int

  recordedById String
  recordedBy   User     @relation("MedicalHistoryRecorder", fields: [recordedById], references: [id])
  /// Clinical event time — may be set by staff to reflect when the history
  /// was actually taken, distinct from createdAt's fixed insert timestamp.
  recordedAt   DateTime @default(now())

  /// Exclusive state — see model doc comment above.
  noKnownConditions Boolean @default(false)

  /// Free-text allergy summary (e.g. "Penicillin - anaphylaxis"). Sensitive
  /// free text — redacted (not the row) on patient anonymization, see
  /// services/privacy/patientAnonymization.ts. Relational, coded allergy
  /// entries also live in PatientCondition (category = allergy); this field
  /// is the free-text clinical summary alongside those structured entries.
  allergies          String?
  /// Free-text current-medications summary. Same anonymization treatment as allergies.
  currentMedications String?

  /// unknown | not_pregnant | pregnant | not_applicable
  pregnancyStatus    String    @default("unknown")
  pregnancyStartDate DateTime?

  createdAt DateTime @default(now())

  conditions PatientCondition[]

  @@unique([patientId, version])
  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId, createdAt])
}

/// Global, tenant-independent ICD-10-compatible medical condition lookup
/// catalog — reference data (like AppointmentType is clinic-scoped reference
/// data), NOT patient data, so no organizationId/clinicId/patientId here.
/// Seeded deterministically and idempotently by
/// server/prisma/seedMedicalConditions.ts (upsert-by-code — safe to re-run,
/// safe in production). Initial coverage is a SMALL, dental-clinic-relevant
/// subset of standard ICD-10 codes — NOT the full global ICD-10 catalog (see
/// that file's header comment for the documented initial list and its
/// deliberately limited scope).
model MedicalCondition {
  id        String   @id @default(uuid())
  /// Standard ICD-10 code, e.g. "E11.9", "Z88.0". Stable identifier — never
  /// reused for a different clinical meaning; extend the catalog by adding
  /// new rows, never by repurposing an existing code.
  code      String   @unique
  /// systemic | allergy | medication_risk | dental | obstetric | behavioral
  category  String
  nameEn    String
  nameTr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  patientLinks PatientCondition[]

  @@index([category])
}

/// One row per condition linked to one specific PatientMedicalHistory
/// version. Written together with its parent version in the same
/// transaction and never updated/deleted afterwards — the same immutability
/// guarantee as its parent (a later change is recorded as a new
/// PatientMedicalHistory version with its own fresh PatientCondition rows,
/// never as an edit of a past version's rows). organizationId/clinicId are
/// denormalized from the parent history row so scoped queries and the
/// privacy export (patientPrivacy.ts) never need a join back through
/// PatientMedicalHistory just to filter by tenant/clinic.
model PatientCondition {
  id          String                @id @default(uuid())
  historyId   String
  history     PatientMedicalHistory @relation(fields: [historyId], references: [id])
  conditionId String
  condition   MedicalCondition      @relation(fields: [conditionId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  /// active | resolved | historical
  status String  @default("active")
  /// Free-text clinical note about this specific condition instance (e.g.
  /// severity, onset). Sensitive free text — redacted on anonymization, same
  /// treatment as PatientMedicalHistory.allergies.
  note   String?

  createdAt DateTime @default(now())

  @@index([historyId])
  @@index([conditionId])
  @@index([patientId])
  @@index([clinicId])
  @@index([organizationId])
}

model AppointmentType {
  id              String   @id @default(uuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  name            String
  durationMinutes Int
  color           String?
  isActive        Boolean  @default(true)
  category        String?
  description     String?
  basePrice       Float?
  currency        String?
  isService       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments            Appointment[]
  appointmentRequests     AppointmentRequest[]
  treatmentCases          TreatmentCase[]
  serviceCompRules        ServiceCompensationRule[]      @relation("ServiceCompRules")
  practitionerEarnings    PractitionerEarning[]          @relation("EarningService")
  treatmentPlanProcedures TreatmentPlanProcedure[]
  packageItems            TreatmentPackageItem[]
  materials               AppointmentTypeMaterial[]
  inventoryTransactions   InventoryTransaction[]         @relation("InventoryTransactionService")
  postTreatmentTemplates  PostTreatmentMessageTemplate[]
  postTreatmentQueue      PostTreatmentMessageQueue[]
}

model Appointment {
  id                 String          @id @default(uuid())
  clinicId           String
  clinic             Clinic          @relation(fields: [clinicId], references: [id])
  patientId          String
  patient            Patient         @relation(fields: [patientId], references: [id])
  practitionerId     String
  practitioner       User            @relation("Practitioner", fields: [practitionerId], references: [id])
  appointmentTypeId  String
  appointmentType    AppointmentType @relation(fields: [appointmentTypeId], references: [id])
  title              String?
  startTime          DateTime
  endTime            DateTime
  status             String          @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show, etc.
  notes              String?
  cancellationReason String?
  noShowReason       String?
  // No-show recovery fields (Sprint 18)
  noShowMarkedAt     DateTime?
  noShowMarkedById   String?
  recoveryStatus     String? // unresolved | contacted | recovered
  recoveryNote       String?
  recoveredAt        DateTime?
  recoveredById      String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  treatmentCaseId String?
  treatmentCase   TreatmentCase? @relation(fields: [treatmentCaseId], references: [id])

  tasks                 Task[]
  sentMessages          SentMessage[]
  activityLogs          ActivityLog[]
  recallCandidates      RecallCandidate[]
  recallActions         RecallAction[]
  sourceRequests        AppointmentRequest[]              @relation("ConvertedAppointment")
  smsMessages           SmsMessage[]
  imagingRequests       ImagingRequest[]
  imagingStudies        ImagingStudy[]
  externalCalendarLinks ExternalCalendarAppointmentLink[]

  // Postgres'te Prisma FK kolonlarına otomatik indeks koymaz; takvim ve
  // uygunluk (available-slots) sorguları bu indeksler olmadan tablo taraması yapar.
  @@index([clinicId, startTime])
  @@index([practitionerId, startTime])
  @@index([patientId])
}

model AppointmentRequest {
  id                     String           @id @default(uuid())
  clinicId               String
  clinic                 Clinic           @relation(fields: [clinicId], references: [id])
  patientId              String?
  patient                Patient?         @relation(fields: [patientId], references: [id])
  patientName            String
  phone                  String
  email                  String?
  appointmentTypeId      String?
  appointmentType        AppointmentType? @relation(fields: [appointmentTypeId], references: [id])
  practitionerId         String?
  practitioner           User?            @relation("AppointmentRequestPractitioner", fields: [practitionerId], references: [id])
  preferredStartTime     DateTime?
  preferredEndTime       DateTime?
  requestType            String           @default("appointment") // appointment, reschedule, cancel, info
  source                 String           @default("whatsapp")
  externalSenderId       String?
  sourceConnectionId     String?
  sourceInboxEntryId     String?
  sourceConversationId   String?
  status                 String           @default("pending") // pending, approved, rejected, converted, closed
  rawMessage             String?
  notes                  String?
  rejectionReason        String?
  convertedAppointmentId String?
  convertedAppointment   Appointment?     @relation("ConvertedAppointment", fields: [convertedAppointmentId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  noticeEvidence PublicBookingNoticeEvidence?

  @@index([clinicId, status, createdAt])
  @@index([clinicId, phone])
  @@index([clinicId, practitionerId])
  @@index([source, status, createdAt])
  @@index([sourceInboxEntryId])
}

model ContactRequest {
  id                   String    @id @default(uuid())
  clinicId             String
  clinic               Clinic    @relation(fields: [clinicId], references: [id])
  patientId            String?
  patient              Patient?  @relation(fields: [patientId], references: [id])
  channel              String // whatsapp, meta_whatsapp, instagram, manual
  sourceConversationId String?
  sourceMessageId      String?
  externalSenderId     String?
  phone                String?
  name                 String?
  type                 String    @default("staff_handoff") // callback_request, staff_handoff, information_request, complaint, other
  status               String    @default("pending") // pending, in_progress, resolved, closed
  priority             String    @default("normal") // normal, urgent
  note                 String?
  lastMessage          String?
  assignedToId         String?
  assignedTo           User?     @relation("ContactRequestAssignee", fields: [assignedToId], references: [id])
  resolvedById         String?
  resolvedBy           User?     @relation("ContactRequestResolver", fields: [resolvedById], references: [id])
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, channel])
  @@index([clinicId, externalSenderId])
  @@index([clinicId, createdAt])
}

model WhatsAppConversationState {
  id                          String   @id @default(uuid())
  clinicId                    String
  clinic                      Clinic   @relation(fields: [clinicId], references: [id])
  phone                       String
  lastProviderMessageId       String?
  customerName                String?
  currentIntent               String?
  step                        String?
  selectedAppointmentTypeId   String?
  selectedAppointmentTypeName String?
  selectedPractitionerId      String?
  selectedDate                String?
  selectedTime                String?
  lastMessage                 String?
  stateJson                   Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([clinicId, phone])
  @@index([clinicId, updatedAt])
}

model WhatsAppConversationMessage {
  id                String   @id @default(uuid())
  clinicId          String
  clinic            Clinic   @relation(fields: [clinicId], references: [id])
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id])
  phone             String
  providerMessageId String?
  direction         String
  text              String
  rawPayload        Json?
  createdAt         DateTime @default(now())

  @@unique([clinicId, providerMessageId])
  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, phone, createdAt])
}

model TreatmentCase {
  id                String           @id @default(uuid())
  clinicId          String
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id])
  practitionerId    String?
  practitioner      User?            @relation("Practitioner", fields: [practitionerId], references: [id])
  appointmentTypeId String?
  appointmentType   AppointmentType? @relation(fields: [appointmentTypeId], references: [id])
  title             String
  description       String?
  stage             String           @default("new") // new, quote_sent, in_progress, completed, lost
  estimatedAmount   Float?
  acceptedAmount    Float?
  currency          String?
  expectedStartDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  tasks                 Task[]
  appointments          Appointment[]
  payments              Payment[]
  insuranceProvisions   InsuranceProvision[]
  sentMessages          SentMessage[]
  activityLogs          ActivityLog[]
  paymentPlans          PaymentPlan[]
  practitionerEarnings  PractitionerEarning[]
  inventoryTransactions InventoryTransaction[]
  procedures            TreatmentPlanProcedure[]
  packageApplications   TreatmentPackageApplication[]
  recallCandidates      RecallCandidate[]
  labWorkOrders         LabWorkOrder[]
  imagingRequests       ImagingRequest[]
  imagingStudies        ImagingStudy[]
}

model TreatmentPackage {
  id              String   @id @default(uuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  name            String
  description     String?
  category        String?
  color           String?
  durationMinutes Int?
  price           Float?
  currency        String   @default("TRY")
  pricingMode     String   @default("PACKAGE_PRICE") // PACKAGE_PRICE | SERVICE_SUM
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items                  TreatmentPackageItem[]
  materials              TreatmentPackageMaterial[]
  applications           TreatmentPackageApplication[]
  procedures             TreatmentPlanProcedure[]
  inventoryTransactions  InventoryTransaction[]
  postTreatmentTemplates PostTreatmentMessageTemplate[]
  postTreatmentQueue     PostTreatmentMessageQueue[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
}

model TreatmentPackageItem {
  id                  String           @id @default(uuid())
  clinicId            String
  clinic              Clinic           @relation(fields: [clinicId], references: [id])
  packageId           String
  treatmentPackage    TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId           String
  service             AppointmentType  @relation(fields: [serviceId], references: [id])
  quantity            Int              @default(1)
  sortOrder           Int              @default(0)
  overridePrice       Float?
  overrideDurationMin Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  procedures TreatmentPlanProcedure[]

  @@unique([packageId, serviceId])
  @@index([clinicId])
  @@index([packageId])
  @@index([serviceId])
}

model AppointmentTypeMaterial {
  id              String          @id @default(uuid())
  clinicId        String
  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  serviceId       String
  service         AppointmentType @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  quantity        Float
  unit            String?
  deductionTiming String          @default("ON_TREATMENT_COMPLETED")
  isOptional      Boolean         @default(false)
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([serviceId, inventoryItemId])
  @@index([clinicId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

model TreatmentPackageMaterial {
  id               String           @id @default(uuid())
  clinicId         String
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  packageId        String
  treatmentPackage TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  quantity         Float
  unit             String?
  deductionTiming  String           @default("ON_TREATMENT_COMPLETED")
  isOptional       Boolean          @default(false)
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([packageId, inventoryItemId])
  @@index([clinicId])
  @@index([packageId])
  @@index([inventoryItemId])
}

model TreatmentPackageApplication {
  id                            String           @id @default(uuid())
  clinicId                      String
  clinic                        Clinic           @relation(fields: [clinicId], references: [id])
  treatmentCaseId               String
  treatmentCase                 TreatmentCase    @relation(fields: [treatmentCaseId], references: [id])
  patientId                     String
  patient                       Patient          @relation(fields: [patientId], references: [id])
  packageId                     String
  treatmentPackage              TreatmentPackage @relation(fields: [packageId], references: [id])
  pricingMode                   String
  totalDurationMinutes          Int?
  totalPrice                    Float?
  currency                      String?
  createdById                   String
  createdBy                     User             @relation("TreatmentPackageApplicationCreator", fields: [createdById], references: [id])
  extraMaterialsDeductedAt      DateTime?
  extraMaterialsDeductionStatus String?
  extraMaterialsDeductionError  String?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  procedures            TreatmentPlanProcedure[]
  inventoryTransactions InventoryTransaction[]

  @@index([clinicId, treatmentCaseId])
  @@index([clinicId, packageId])
  @@index([clinicId, patientId])
}

model InsuranceProvision {
  id                          String         @id @default(uuid())
  clinicId                    String
  clinic                      Clinic         @relation(fields: [clinicId], references: [id])
  patientId                   String
  patient                     Patient        @relation(fields: [patientId], references: [id])
  treatmentCaseId             String?
  treatmentCase               TreatmentCase? @relation(fields: [treatmentCaseId], references: [id])
  insuranceProviderName       String
  insuranceType               String
  policyNumber                String?
  provisionNumber             String?
  status                      String         @default("draft")
  requestedAmount             Float
  approvedAmount              Float?
  patientResponsibilityAmount Float?
  currency                    String         @default("TRY")
  submittedAt                 DateTime?
  respondedAt                 DateTime?
  rejectionReason             String?
  notes                       String?
  assignedToId                String?
  assignedTo                  User?          @relation("InsuranceAssignedTo", fields: [assignedToId], references: [id])
  createdById                 String
  createdBy                   User           @relation("InsuranceCreatedBy", fields: [createdById], references: [id])
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  activityLogs ActivityLog[]
}

model Task {
  id              String         @id @default(uuid())
  clinicId        String
  clinic          Clinic         @relation(fields: [clinicId], references: [id])
  patientId       String?
  patient         Patient?       @relation(fields: [patientId], references: [id])
  treatmentCaseId String?
  treatmentCase   TreatmentCase? @relation(fields: [treatmentCaseId], references: [id])
  appointmentId   String?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  assignedToId    String?
  assignedTo      User?          @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User           @relation("TaskCreator", fields: [createdById], references: [id])
  title           String
  description     String?
  dueDate         DateTime?
  status          String         @default("open") // open, in_progress, completed, cancelled
  priority        String         @default("normal") // low, normal, high, urgent
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recallActions RecallAction[]

  @@index([clinicId, status])
}

model Payment {
  id              String         @id @default(uuid())
  clinicId        String
  clinic          Clinic         @relation(fields: [clinicId], references: [id])
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  treatmentCaseId String?
  treatmentCase   TreatmentCase? @relation(fields: [treatmentCaseId], references: [id])
  amount          Float
  currency        String
  paymentMethod   String // cash, card, bank_transfer, etc.
  paymentStatus   String         @default("pending") // pending, partial, paid, refunded, cancelled
  paidAt          DateTime?
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sentMessages         SentMessage[]
  installment          PaymentPlanInstallment?
  practitionerEarnings PractitionerEarning[]
  recallCandidates     RecallCandidate[]

  @@index([clinicId, createdAt])
  @@index([patientId])
}

model MessageTemplate {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  channel   String // sms, whatsapp, email
  subject   String?
  body      String
  language  String   @default("en")
  isActive  Boolean  @default(true)
  purpose   String   @default("general_message") // appointment_reminder | payment_reminder | appointment_confirmation | no_show_recovery | post_treatment_followup | general_message
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TemplateCreator", fields: [createdById], references: [id])

  // Meta WhatsApp Template Management
  metaTemplateName            String?
  metaTemplateLanguage        String?
  metaTemplateCategory        String? // utility, marketing, authentication
  metaTemplateStatus          String? // draft, submitted, approved, rejected, paused, disabled, unknown
  metaTemplateId              String?
  metaTemplateRejectionReason String?
  metaTemplateLastSyncedAt    DateTime?
  metaTemplateSubmittedAt     DateTime?
  metaTemplateVariableMap     Json?

  // Snapshot of the WhatsApp connection/WABA this template was submitted against.
  // Lets us detect when a clinic's active connection later changes to a different
  // WABA, so a previously-approved template isn't silently trusted for the new one.
  metaTemplateConnectionId  String?
  metaTemplateConnection    WhatsAppConnection? @relation("MessageTemplateMetaConnection", fields: [metaTemplateConnectionId], references: [id])
  metaWabaIdSnapshot        String?
  metaPhoneNumberIdSnapshot String?

  sentMessages     SentMessage[]
  recallCandidates RecallCandidate[]
  smsMessages      SmsMessage[]      @relation("SmsMessageTemplate")

  @@index([metaTemplateConnectionId])
}

model SentMessage {
  id                   String              @id @default(uuid())
  clinicId             String
  clinic               Clinic              @relation(fields: [clinicId], references: [id])
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id])
  appointmentId        String?
  appointment          Appointment?        @relation(fields: [appointmentId], references: [id])
  treatmentCaseId      String?
  treatmentCase        TreatmentCase?      @relation(fields: [treatmentCaseId], references: [id])
  paymentId            String?
  payment              Payment?            @relation(fields: [paymentId], references: [id])
  templateId           String?
  template             MessageTemplate?    @relation(fields: [templateId], references: [id])
  channel              String
  recipient            String
  subject              String?
  body                 String
  status               String              @default("prepared") // prepared, sent, failed, delivered, read, blocked_by_consent
  providerMessageId    String?
  sentAt               DateTime?
  createdById          String?
  createdBy            User?               @relation(fields: [createdById], references: [id])
  // Provider-agnostic WhatsApp extension fields
  organizationId       String?
  organization         Organization?       @relation(fields: [organizationId], references: [id])
  whatsappConnectionId String?
  whatsappConnection   WhatsAppConnection? @relation(fields: [whatsappConnectionId], references: [id])
  provider             String? // evolution_api | meta_cloud_api
  direction            String? // outgoing | incoming
  externalMessageId    String? // Provider message ID for tracking
  createdAt            DateTime            @default(now())

  recallActions RecallAction[]

  // Reminder job'ın randevu başına dedup kontrolü (clinicId+appointmentId) ve
  // taksit hatırlatması dedup anahtarı (clinicId+subject) bu indeksleri kullanır.
  @@index([clinicId, appointmentId, createdAt])
  @@index([clinicId, subject])
  @@index([patientId])
}

model ActivityLog {
  id                   String   @id @default(uuid())
  clinicId             String
  clinic               Clinic   @relation(fields: [clinicId], references: [id])
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  entityType           String
  entityId             String // Legacy or general fallback
