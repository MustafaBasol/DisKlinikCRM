/// Global platform-level key-value settings (e.g. runtime feature toggles).
model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Durable, create-only audit trail for Platform Admin configuration changes
/// (e.g. PlatformSetting toggles). Deliberately separate from
/// SecuritySignalEvent: that table is security-detection telemetry read by
/// securityDetectionRules.ts for incident aggregation, and a config change is
/// not a security signal — mixing the two domains would create retention/
/// reporting ambiguity and risk future detection rules misinterpreting
/// routine admin changes. Never contains patient data or secret values.
/// onDelete: SetNull so a deleted/deactivated Platform Admin never destroys
/// audit history.
model PlatformAdminAuditEvent {
  id String @id @default(uuid())

  actorPlatformAdminId String?
  actorPlatformAdmin   PlatformAdmin? @relation("PlatformAdminAuditActor", fields: [actorPlatformAdminId], references: [id], onDelete: SetNull)

  /// e.g. "platform_setting.updated"
  action String

  resourceType String
  /// The PlatformSetting key (or other resource identifier) this event concerns.
  resourceKey  String

  previousValue String?
  newValue      String?

  /// Most actions (e.g. "platform_setting.updated") only ever record
  /// "success" — those mutations either commit with their audit row or roll
  /// back entirely (see platformAdminAudit.ts). Actions that audit an
  /// *attempted operation* rather than a single mutation use more outcomes:
  /// e.g. "data_retention.manual_run_started" / "..._completed" /
  /// "..._partial_failure" / "..._blocked" / "..._failed"
  /// (RETENTION-MANUAL-RUN-AUDIT-001, see
  /// services/privacy/dataRetentionManualRunAudit.ts) records a
  /// "started" row (outcome "started") before any live cleanup mutation,
  /// then exactly one terminal row sharing the same safeMetadata.runId —
  /// see that row's safeMetadata.errorCategory for a safe (non-PII) reason
  /// code on non-"success" terminal outcomes.
  outcome String

  /// Sanitized, non-secret, non-patient metadata only.
  safeMetadata Json?

  createdAt DateTime @default(now())

  @@index([actorPlatformAdminId, createdAt])
  @@index([action, createdAt])
}

