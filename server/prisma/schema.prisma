  phone                 String
  displayName           String?
  lastMessageText       String?
  messageCount          Int                 @default(1)
  externalMessageId     String?
  rawPayload            Json?
  needsClinicResolution Boolean             @default(false)
  // open | resolved
  status                String              @default("open")
  resolvedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([organizationId, needsClinicResolution])
  @@index([organizationId, status])
  @@index([organizationId, clinicId])
  @@index([whatsappConnectionId, phone])
}

// ── Sprint 13: Operational Monitoring ────────────────────────────────────────

/// Immutable audit trail of important admin/system actions.
/// Separate from ActivityLog (clinic-scoped, FK-heavy) — AuditLog is org-scoped
/// and designed for compliance, security reviews and operational investigations.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  clinicId       String?
  actorUserId    String?
  actorRole      String?
  action         String // user_login | branch_created | payment_created | ...
  entityType     String // user | branch | appointment | payment | whatsapp_connection | ...
  entityId       String?
  description    String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([clinicId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// System-level operational events: integration failures, webhook errors, etc.
/// Separate from AuditLog — these are monitorable / resolvable events.
model OperationalEvent {
  id             String    @id @default(uuid())
  organizationId String
  clinicId       String?
  // info | warning | error | critical
  severity       String    @default("info")
  // whatsapp | appointment | finance | auth | system
  source         String
  message        String
  metadata       Json?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())

  /// Optional deterministic dedupe key (e.g. "clinic-bulk-export:<jobId>:export_requested").
  /// Left null by every feature that doesn't need dedupe. When set, a create is performed
  /// as an upsert on this unique key so duplicate-alert suppression is atomic (never
  /// check-then-insert) — see clinicBulkExportPackage.ts.
  dedupeKey String? @unique

  @@index([organizationId, severity])
  @@index([organizationId, source])
  @@index([organizationId, resolvedAt])
  @@index([createdAt])
  /// Supports the bounded KVKK-HIGH-007 audit-summary query
  /// (communicationConsentAuditReport.ts): source='communication_consent'
  /// scoped by organization/clinic within a mandatory bounded date range.
  @@index([source, organizationId, clinicId, createdAt])
}

// ── Sprint 23: Instagram DM Integration ──────────────────────────────────────

/// Shared inbound message idempotency ledger for all messaging channels.
/// connectionId is intentionally provider-agnostic: it can reference WhatsAppConnection,
/// InstagramConnection, or a future channel-specific connection model.
model MessagingInboundEvent {
  id                     String    @id @default(uuid())
  channel                String
  provider               String
  connectionId           String?
  clinicId               String?
  organizationId         String?
  providerMessageId      String
  providerConversationId String?
  fromExternalId         String?
  toExternalId           String?
  fromPhone              String?
  toPhone                String?
  eventType              String    @default("message")
  direction              String    @default("inbound")
  status                 String    @default("received")
  /// Retry job'un kaç kez yeniden işlemeyi denediği (docs/45 Faz 2 #6)
  attempts               Int       @default(0)
  rawPayload             Json?
  /// PRE-F5-3 rows carry a raw exception message here. As of F5-3 the writer
  /// records a bounded, non-PII summary and puts the real classification in
  /// `lastErrorCode`; this column is retained for the existing rows and is
  /// NEVER surfaced by the DLQ view.
  errorMessage           String?
  processedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  /// F5-3 — when this event may next be retried. Exponential backoff with
  /// jitter writes it. NULL preserves the pre-F5-3 meaning: eligible as soon
  /// as the job's minimum-age floor has passed.
  nextAttemptAt          DateTime?
  /// F5-3 — stable MessagingFailureCode. Never a provider body, never PII.
  /// This, not `errorMessage`, is what an operator and the metrics read.
  lastErrorCode          String?
  /// F5-3 — set when `status` becomes 'dead'. A terminal event is one nothing
  /// will retry: the attempt ceiling, a permanent classification, an abandoned
  /// retry window, or a channel with no re-delivery handler.
  deadLetteredAt         DateTime?
  /// F5-3 — replay audit. The full record goes to AuditLog; these make the
  /// state visible without a join.
  replayCount            Int       @default(0)
  lastReplayedAt         DateTime?
  lastReplayedBy         String?

  @@unique([channel, provider, connectionId, providerMessageId])
  @@index([organizationId, status, createdAt])
  @@index([clinicId, status, createdAt])
  @@index([channel, provider, providerMessageId])
  @@index([status, updatedAt])
  /// F5-3 — the retry job's claim scan, and the oldest-pending-age metric.
  @@index([status, nextAttemptAt])
}

/// Cron job'lar için paylaşımlı lease kilidi (docs/45 Faz 3 #9-10).
/// Birden fazla API/worker replikası çalışırken aynı job'un aynı anda iki kez
/// koşmasını engeller: lease süresi (lockedUntil) dolmadan başka süreç kilidi
/// alamaz. Süreç çökerse lease kendiliğinden düşer, yenisi devralır.
model JobLock {
  name        String   @id
  lockedUntil DateTime
  lockedBy    String
  updatedAt   DateTime @updatedAt
}

