/// Automatic evidence that a clinic's published Art. 10 privacy notice was
/// displayed to a public-booking visitor. This is NOT a consent record: no
/// acknowledgment action is required to create it, and it must never be
/// treated as proof of consent anywhere in the codebase. See
/// docs/compliance/KVKK_COMPLIANCE_AUDIT_AND_REMEDIATION.md (KVKK-CRIT-001a).
///
/// Snapshot fields exist because ClinicLegalProfile rows are mutable in
/// place (publish can be re-run to edit an already-published profile), so a
/// mutable FK alone would not preserve historical notice attribution.
model PublicBookingNoticeEvidence {
  id             String              @id @default(uuid())
  organizationId String
  clinicId       String
  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  legalProfileId String?
  legalProfile   ClinicLegalProfile? @relation(fields: [legalProfileId], references: [id], onDelete: SetNull)

  /// Opaque per-tab/session identifier generated client-side (not a patient
  /// identifier) — used only to make bootstrap idempotent across re-renders
  /// and page refreshes within the same booking session.
  sessionId String

  /// SHA-256 hash of the opaque server-issued token the client must echo
  /// back with the booking submission. The raw token itself is returned to
  /// the client once and never persisted — only its hash is stored, so a
  /// database read cannot recover a usable token. Always server-generated —
  /// never trusted if supplied by the client anywhere else.
  tokenHash String @unique

  appointmentRequestId String?             @unique
  appointmentRequest   AppointmentRequest? @relation(fields: [appointmentRequestId], references: [id], onDelete: SetNull)

  noticeVersion       String
  noticeEffectiveDate DateTime?
  language            String    @default("tr")
  /// Fixed to "web_booking" for this flow; kept as a column (not a literal)
  /// so other future channels can reuse this table without a schema change.
  channel             String    @default("web_booking")
  /// Timestamp the server issued/delivered the notice payload to the
  /// client. This proves server-side delivery only, NOT that the visitor
  /// actually read or scrolled to the notice — never describe it as proof
  /// of reading or review anywhere in code, UI copy, or documentation.
  deliveredAt         DateTime  @default(now())

  noticeTextSnapshot     String
  controllerNameSnapshot String
  privacyContactSnapshot String?
  noticeHash             String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clinicId, sessionId, channel])
  @@index([organizationId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ChannelConsentLog {
  id                  String    @id @default(uuid())
  organizationId      String
  clinicId            String
  clinic              Clinic    @relation(fields: [clinicId], references: [id])
  channel             String // whatsapp | instagram
  contactIdentifier   String // normalized phone (WA) or externalSenderId (Instagram)
  conversationId      String? // conversation key or inbox entry id
  sourceMessageId     String? // provider message id of the consent reply
  consentStatus       String // accepted | declined
  consentTextVersion  String
  consentTextSnapshot String
  privacyUrl          String
  locale              String    @default("tr")
  acceptedAt          DateTime?
  declinedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([clinicId, channel, contactIdentifier])
  @@index([clinicId, consentTextVersion])
  @@index([organizationId])
}

// ── Communication Preference & Consent Management (KVKK-HIGH-007) ─────────────
//
// Technical control only — not a legal determination. See
// docs/compliance/56-kvkk-communication-preference-and-consent-management.md.
//
// Two-table design:
//  - PatientCommunicationPreference: current effective state, one row per
//    patient+clinic+channel+purpose (fast lookup for every send decision;
//    upserted atomically so concurrent grant/withdraw races resolve to a
//    single deterministic row via the DB unique constraint).
//  - PatientCommunicationConsentEvent: immutable append-only history/evidence
//    of every state transition. Never updated or deleted by application code.
//
// This is separate from ChannelConsentLog, which records WhatsApp/Instagram
// inbound-reply opt-in to the Meta 24h messaging window (contact-identifier
// keyed, channel-only, no purpose dimension) — a narrower, provider-specific
// concern that predates this general-purpose model.

/// Current effective communication preference for one patient+clinic+channel+purpose.
/// Looked up by the central decision service (communicationConsentPolicy.ts) on
/// every send. A missing row means status = unknown (never implicitly granted).
model PatientCommunicationPreference {
  id             String  @id @default(uuid())
  organizationId String
  clinicId       String
  clinic         Clinic  @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient @relation(fields: [patientId], references: [id])

  /// sms | email | whatsapp | phone_call | push
  channel String
  /// transactional | appointment_reminder | appointment_followup | clinical_followup |
  /// recall | no_show_recovery | operational | marketing | campaign | survey |
  /// legal_notice | security_notice
  purpose String

  /// granted | denied | withdrawn | unknown | not_required
  status      String    @default("unknown")
  effectiveAt DateTime  @default(now())
  grantedAt   DateTime?
  withdrawnAt DateTime?
  expiresAt   DateTime?

  /// Monotonic per-key revision counter, incremented under a
  /// pg_advisory_xact_lock in setCommunicationPreference() (see
  /// communicationConsentAdmin.ts). This — not createdAt/updatedAt, which are
  /// only millisecond-precision and can tie under concurrency — is the
  /// authoritative order for this row's transition history. Matches the
  /// revision on the PatientCommunicationConsentEvent row written in the same
  /// transaction.
  revision Int @default(1)

  /// patient_portal | public_booking | staff | import | api | whatsapp |
  /// sms_keyword | email_unsubscribe | legacy | system
  source String

  /// Free-form evidence classification, e.g. verbal_staff_record | signed_form |
  /// portal_click | inbound_reply | public_booking_checkbox
  evidenceType  String?
  /// Legal notice / KVKK text version shown at the time of the decision
  noticeVersion String?
  /// Internal policy/config version applied by the decision service
  policyVersion String?

  actorUserId          String?
  actorPlatformAdminId String?
  /// Hashed with COMMUNICATION_CONSENT_EVIDENCE_HASH_SECRET — never raw
  requestIpHash        String?
  /// Hashed with COMMUNICATION_CONSENT_EVIDENCE_HASH_SECRET — never raw
  userAgentHash        String?
  externalProviderRef  String?
  /// Sanitized, bounded free text — see consentEvidenceSanitizer.ts
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PatientCommunicationConsentEvent[]

  @@unique([patientId, clinicId, channel, purpose])
  @@index([clinicId, channel, purpose, status])
  @@index([organizationId])
}

/// Immutable history/evidence record. One row is inserted every time a
/// PatientCommunicationPreference is created or its status changes. Rows are
/// never updated or deleted by application code (append-only audit trail).
model PatientCommunicationConsentEvent {
  id             String                         @id @default(uuid())
  organizationId String
  clinicId       String
  clinic         Clinic                         @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient                        @relation(fields: [patientId], references: [id])
  preferenceId   String
  preference     PatientCommunicationPreference @relation(fields: [preferenceId], references: [id])

  channel String
  purpose String

  previousStatus String?
  newStatus      String

  /// The PatientCommunicationPreference.revision this event corresponds to —
  /// the authoritative, gap-free, deterministic order for this key's history.
  /// Never infer order from createdAt alone (timestamp precision can tie
  /// under concurrency); always order by revision.
  revision Int

  source               String
  evidenceType         String?
  noticeVersion        String?
  policyVersion        String?
  actorUserId          String?
  actorPlatformAdminId String?
  requestIpHash        String?
  userAgentHash        String?
  externalProviderRef  String?
  notes                String?

  createdAt DateTime @default(now())

  @@unique([preferenceId, revision])
  @@index([patientId, clinicId, channel, purpose, createdAt])
  @@index([clinicId, createdAt])
  @@index([organizationId])
}

/// Database-backed, atomically-upserted aggregate of legacy/central consent
/// conflicts (KVKK-HIGH-007 reconciliation follow-up) — e.g. a dormant legacy
/// Patient.smsOptOut=true alongside an explicit central `granted` row for the
/// same channel/purpose. Deliberately NOT process-local (NoraMedi runs
/// multiple API instances/workers with PM2 reloads and horizontal scaling —
/// an in-memory Map would deduplicate differently per process, lose counts on
/// restart, and produce duplicate rows across instances). One row per
/// (organization, clinic, channel, purpose, reasonCode, hourly bucket);
/// every detection is a single atomic Postgres upsert that creates the row
/// with occurrenceCount=1 or increments it — safe under concurrency
/// regardless of how many processes are running.
///
/// Deliberately excludes any patient-level identifier (no patientId, no
/// patient name/phone/email, no message text, no raw or hashed contact
/// identifier, no IP, no user-agent) — this table can report how many
/// conflicts occurred, never which specific patients they involved.
model CommunicationConsentConflictBucket {
  id             String @id @default(uuid())
  organizationId String
  clinicId       String
  channel        String
  purpose        String
  reasonCode     String

  /// Start of the hourly bucket this row aggregates (floor of detection time to the hour).
  bucketStartedAt DateTime
  firstDetectedAt DateTime
  lastDetectedAt  DateTime
  occurrenceCount Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, clinicId, channel, purpose, reasonCode, bucketStartedAt])
  @@index([organizationId, clinicId, createdAt])
  @@index([bucketStartedAt])
}

/// Closed set of legacy consent-adjacent fields that support a supported,
/// audited correction workflow. Extend by adding an enum value (additive
/// migration) — never widen fieldName to a free-form string, since the
/// correction workflow's behavior (which Patient column it flips, which
/// error codes apply) is hard-coded per value, not data-driven.
enum PatientLegacyConsentField {
  SMS_OPT_OUT
}

/// Immutable, create-only evidence record for KVKK-HIGH-008: an authorized
/// management user (OWNER/ORG_ADMIN/CLINIC_MANAGER) marking a legacy consent
/// signal (e.g. Patient.smsOptOut) as stale/incorrect. This is NOT a central
/// consent grant/deny/withdraw event — it never touches
/// PatientCommunicationPreference/PatientCommunicationConsentEvent and never
/// grants consent. No update/delete route exists or should ever exist for
/// this model; there is deliberately no updatedAt column.
model PatientLegacyConsentCorrection {
  id                 String                    @id @default(uuid())
  organizationId     String
  organization       Organization              @relation(fields: [organizationId], references: [id])
  clinicId           String
  clinic             Clinic                    @relation(fields: [clinicId], references: [id])
  patientId          String
  patient            Patient                   @relation(fields: [patientId], references: [id])
  fieldName          PatientLegacyConsentField
  previousValue      Boolean
  newValue           Boolean
  /// Verbatim copy of the live field's prior "recorded at" timestamp (e.g.
  /// Patient.smsOptOutAt) at the moment of correction — preserved here even
  /// though the live column is cleared, so historical meaning is never lost.
  previousRecordedAt DateTime?
  correctionReason   String
  evidenceType       String
  /// Optional external citation (e.g. "phone call log ref 2026-07-18") — NOT
  /// the same concept as PatientCommunicationPreference.source.
  sourceReference    String?
  notes              String
  correctedById      String
  correctedBy        User                      @relation(fields: [correctedById], references: [id])
  /// Client-supplied replay-protection key, scoped per (organizationId, patientId).
  idempotencyKey     String
  /// SHA-256 over a fixed-order canonical payload — detects a reused key with
  /// different content. Never returned in any API response or log.
  requestFingerprint String
  createdAt          DateTime                  @default(now())

  @@unique([organizationId, patientId, idempotencyKey])
  @@index([patientId, createdAt])
  @@index([organizationId, clinicId, createdAt])
}

// ── SMS Add-on Module ─────────────────────────────────────────────────────────

/// Per-clinic SMS add-on configuration. SMS is DISABLED unless addonEnabled=true
/// here or the clinic/organization plan has features.sms === true.
model ClinicSmsSettings {
  id                   String   @id @default(uuid())
  organizationId       String
  clinicId             String   @unique
  clinic               Clinic   @relation(fields: [clinicId], references: [id])
  /// Clinic-level add-on activation (managed by platform admin, sold as package)
  addonEnabled         Boolean  @default(false)
  /// Monthly outbound SMS quota. 0 = no sending allowed even when enabled.
  monthlyQuota         Int      @default(0)
  /// Alphanumeric sender id / originator shown to recipients (provider-dependent)
  senderName           String?
  /// Provider key for Turkish numbers (e.g. mock_turkey; real providers later)
  turkeyProvider       String?
  turkeyProviderConfig Json?
  /// Provider key for European numbers (e.g. mock_europe; real providers later)
  europeProvider       String?
  europeProviderConfig Json?
  /// Destination-region permissions, set only by platform admin. Off by
  /// default for newly-enabled add-ons; existing active clinics were
  /// backfilled to true when this column was introduced (see migration
  /// 20260703100000_add_sms_clinic_routing_policy).
  turkeyAllowed        Boolean  @default(false)
  europeAllowed        Boolean  @default(false)
  /// automatic_by_recipient_phone_region | force_turkey_provider | force_europe_provider
  routingPolicy        String   @default("automatic_by_recipient_phone_region")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId])
}

/// Outbound SMS queue + clinic-scoped history. One row per send attempt,
/// including sends blocked by quota/consent/region so staff can see why.
model SmsMessage {
  id                String           @id @default(uuid())
  organizationId    String
  clinicId          String
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  patientId         String?
  patient           Patient?         @relation(fields: [patientId], references: [id])
  appointmentId     String?
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  templateId        String?
  template          MessageTemplate? @relation("SmsMessageTemplate", fields: [templateId], references: [id])
  /// appointment_confirmation | appointment_reminder | appointment_cancellation |
  /// appointment_reschedule | no_show_recovery | post_treatment_followup |
  /// manual_message | payment_reminder | marketing
  purpose           String
  /// Normalized E.164 recipient (no other personal data duplicated here)
  recipient         String
  body              String
  /// queued | sent | delivered | failed | blocked_addon | blocked_quota |
  /// blocked_consent | blocked_region | blocked_template
  status            String           @default("queued")
  /// tr | eu | unsupported — routing decision snapshot
  providerRegion    String?
  /// Provider key that handled (or would handle) the message
  provider          String?
  externalMessageId String?
  errorCode         String?
  errorMessage      String?
  /// Duplicate prevention key (e.g. purpose+appointment+date); unique when set
  dedupeKey         String?          @unique
  queuedAt          DateTime         @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdById       String?
  createdBy         User?            @relation("SmsMessageCreator", fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clinicId, status, createdAt])
  @@index([clinicId, patientId])
  @@index([organizationId])
}

/// Atomic per-clinic monthly usage counter (period = "YYYY-MM").
/// Incremented with a guarded update so concurrent sends cannot exceed quota.
model SmsUsageCounter {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  period    String
  sentCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([clinicId, period])
}

/// Platform-level SMS provider configuration, managed only by platform admins.
/// Clinics never see or edit these rows; sending falls back to the region's
/// default platform provider when a clinic has no explicit provider override.
model PlatformSmsProvider {
  id            String    @id @default(uuid())
  /// Routing region: tr | eu
  region        String
  /// Adapter key in the provider registry (e.g. mock_turkey, netgsm, twilio)
  providerCode  String
  displayName   String
  isActive      Boolean   @default(false)
  /// Default provider for the region when a clinic has no explicit override
  isDefault     Boolean   @default(false)
  /// Alphanumeric sender id / originator, when the provider supports it
  senderName    String?
  /// API credentials encrypted via encryptJson() — never returned by the API
  credentials   Json?
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([region, providerCode])
  @@index([region, isActive, isDefault])
}

// ── Dental Laboratory Tracking ─────────────────────────────────────────────────

model Laboratory {
  id            String    @id @default(uuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean   @default(true)
  createdById   String?
  createdBy     User?     @relation("LaboratoryCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  labWorkOrders LabWorkOrder[]

  @@index([clinicId, isActive])
}

model LabWorkOrder {
  id              String         @id @default(uuid())
  clinicId        String
  clinic          Clinic         @relation(fields: [clinicId], references: [id])
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  laboratoryId    String
  laboratory      Laboratory     @relation(fields: [laboratoryId], references: [id])
  treatmentCaseId String?
  treatmentCase   TreatmentCase? @relation(fields: [treatmentCaseId], references: [id])
  practitionerId  String?
  practitioner    User?          @relation("LabWorkOrderPractitioner", fields: [practitionerId], references: [id])

  // Work item classification
  workType      String // crown, bridge, denture_full, denture_partial, implant_prosthetic,
  // night_guard, aligner, retainer, repair, temp_prosthetic, other
  toothFdi      String? // comma-separated FDI codes or range, free text (multi-tooth cases)
  shade         String?
  material      String?
  notesForLab   String?
  notesInternal String?

  // Status flow: pending -> impression_taken -> sent_to_lab -> in_progress -> received_from_lab
  //   -> fitting_or_trial -> revision_requested (loops back to sent_to_lab) -> completed
  // cancelled reachable from any non-completed status
  status        String @default("pending")
  revisionCount Int    @default(0)

  impressionTakenAt  DateTime?
  sentToLabAt        DateTime?
  expectedReturnDate DateTime?
  receivedFromLabAt  DateTime?
  fittingScheduledAt DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  // Clinic's own reference only — no invoicing/billing integration
  labCost  Float?
  currency String? // USD | EUR | TRY | GBP | CAD | CHF

  createdById String
  createdBy   User      @relation("LabWorkOrderCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  attachments   LabOrderAttachment[]
  statusHistory LabWorkOrderStatusHistory[]

  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, laboratoryId])
  @@index([clinicId, expectedReturnDate])
}

// Append-only audit trail of status transitions (incl. remake loop-backs), kept
// separate from the generic ActivityLog so the UI can render a compact per-order
// timeline without joining ActivityLog's generic entityType/entityId rows.
model LabWorkOrderStatusHistory {
  id             String       @id @default(uuid())
  labWorkOrderId String
  labWorkOrder   LabWorkOrder @relation(fields: [labWorkOrderId], references: [id])
  fromStatus     String?
  toStatus       String
  note           String?
  changedById    String
  changedBy      User         @relation("LabWorkOrderStatusChanger", fields: [changedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([labWorkOrderId, createdAt])
}

model LabOrderAttachment {
  id             String       @id @default(uuid())
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  labWorkOrderId String
  labWorkOrder   LabWorkOrder @relation(fields: [labWorkOrderId], references: [id])
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  filePath       String
  uploadedById   String
  uploadedBy     User         @relation("LabOrderAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  /// KVKK lifecycle (docs/compliance/53 §16B, R-079): when true, blocks the
  /// physical-delete path for this attachment — the `legalHold: false`
  /// predicate in the DELETE route's conditional `deleteMany` IS the
  /// authorization decision, so a hold that commits first structurally
  /// prevents both the DB delete and the storage deletion that follows it.
  /// Set only via the legal-hold PATCH endpoint (OWNER/ORG_ADMIN) — no
  /// automatic trigger exists, exactly as on PatientAttachment.
  legalHold       Boolean @default(false)
  legalHoldReason String?

  @@index([clinicId, labWorkOrderId])
  @@index([clinicId, legalHold])
}

// ─── Imaging / Device Integration Foundation (Phase 1) ─────────────────────
// Standards-first temel: modality kodları DICOM'dan esinlenir, UID alanları
// gelecekteki DICOMweb/PACS entegrasyonu için nullable tutulur. Orijinal
// görüntüler değişmezdir (immutable) — binary güncelleme/silme endpoint'i yok;
// arşivleme yalnızca ImagingStudy.status'u değiştirir.

model ImagingDevice {
  id             String   @id @default(uuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  name           String
  modality       String // IO | PX | CT | CEPH | IO_CAMERA | SCANNER | OTHER
  manufacturer   String?
  modelName      String?
  connectionType String   @default("manual") // manual | bridge | dicomweb (bridge/dicomweb: gelecek fazlar)
  isActive       Boolean  @default(true)
  notes          String?
  createdById    String
  createdBy      User     @relation("ImagingDeviceCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imagingRequests ImagingRequest[]
  imagingStudies  ImagingStudy[]

  @@index([clinicId, isActive])
}

// Minimal çekim istemi (acquisition job) — gelecekte DICOM Modality Worklist
// ve köprü (bridge) işleri bu modele bağlanır.
model ImagingRequest {
  id                String         @id @default(uuid())
  clinicId          String
  clinic            Clinic         @relation(fields: [clinicId], references: [id])
  patientId         String
  patient           Patient        @relation(fields: [patientId], references: [id])
  appointmentId     String?
  appointment       Appointment?   @relation(fields: [appointmentId], references: [id])
  treatmentCaseId   String?
  treatmentCase     TreatmentCase? @relation(fields: [treatmentCaseId], references: [id])
  requestedModality String // IO | PX | CT | CEPH | IO_CAMERA | SCANNER | OTHER
  requestedDeviceId String?
  requestedDevice   ImagingDevice? @relation(fields: [requestedDeviceId], references: [id])
  status            String         @default("requested") // requested | scheduled | received | cancelled | failed
  priority          String? // routine | urgent
  notes             String?
  requestedByUserId String
  requestedBy       User           @relation("ImagingRequestRequester", fields: [requestedByUserId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  imagingStudies ImagingStudy[]

  @@index([clinicId, status])
  @@index([clinicId, patientId])
}

model ImagingStudy {
  id               String              @id @default(uuid())
  clinicId         String
  clinic           Clinic              @relation(fields: [clinicId], references: [id])
  patientId        String? // NULL ⇒ bağlanmamış kuyruğu (unlinked queue)
  patient          Patient?            @relation(fields: [patientId], references: [id])
  appointmentId    String?
  appointment      Appointment?        @relation(fields: [appointmentId], references: [id])
  treatmentCaseId  String?
  treatmentCase    TreatmentCase?      @relation(fields: [treatmentCaseId], references: [id])
  deviceId         String?
  device           ImagingDevice?      @relation(fields: [deviceId], references: [id])
  imagingRequestId String?
  imagingRequest   ImagingRequest?     @relation(fields: [imagingRequestId], references: [id])
  modality         String // IO | PX | CT | CEPH | IO_CAMERA | SCANNER | OTHER
  studyDate        DateTime            @default(now())
  description      String?
  source           String              @default("manual_upload") // manual_upload | bridge | import
  status           String              @default("active") // active | archived — tanısal veri hiç hard-delete edilmez
  studyInstanceUid String? // DICOMweb-uyumluluk için; manuel yüklemede boş kalır
  // Bridge yüklemelerinin kullanıcı aktörü yoktur — createdById bu yüzden nullable.
  createdById      String?
  createdBy        User?               @relation("ImagingStudyCreator", fields: [createdById], references: [id])
  bridgeAgentId    String? // source: 'bridge' olan çalışmalarda provenance; unique constraint'in parçası DEĞİL
  bridgeAgent      ImagingBridgeAgent? @relation(fields: [bridgeAgentId], references: [id])
  // Bridge ingest idempotency: ajanın gönderdiği sha256, sunucuda yeniden
  // hesaplanıp doğrulanır (bkz. routes/imagingBridgePublic.ts). clinicId ile
  // birlikte tekilleştirilir — bridgeAgentId ile DEĞİL, böylece ajan
  // değişse/çoğalsa bile aynı dosya iki kez yüklenemez. Manuel yüklemelerde
  // NULL kalır (Postgres NULL'ları unique constraint'te çakıştırmaz).
  ingestKey        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  /// KVKK lifecycle (docs/compliance/53): blocks anonymization metadata
  /// redaction of every image under this study. Images do not carry their
  /// own legal-hold field — they inherit the study's. Set only via the
  /// legal-hold PATCH endpoint (OWNER/ORG_ADMIN); no automatic trigger.
  legalHold       Boolean @default(false)
  legalHoldReason String?

  images ImagingImage[]

  @@unique([clinicId, ingestKey])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@index([clinicId, legalHold])
}

// Yerel klinik köprü ajanı (bridge/agent) kayıt + heartbeat sözleşmesi.
// Phase 2'de yalnızca kayıt/iptal/heartbeat vardır; iş çekme (job polling)
// ve görüntü yükleme gelecek fazların işidir (docs/47).
// tokenHash: köprü token'ının sha256 hex özeti — düz metin token yalnızca
// oluşturma yanıtında BİR KEZ gösterilir, asla saklanmaz/loglanmaz.
model ImagingBridgeAgent {
  id           String    @id @default(uuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  name         String
  tokenHash    String    @unique
  status       String    @default("pending") // pending | online | offline | revoked
  lastSeenAt   DateTime?
  agentVersion String?
  createdById  String
  createdBy    User      @relation("ImagingBridgeAgentCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Windows self-service bridge metadata (docs/spec: self-service imaging bridge).
  // Never store: Windows username, raw hardware serial, MAC address, full local
  // paths, original file names, patient identity.
  installationId         String?   @unique
  machineIdHash          String? // risk/diagnostic signal only — never an auth mechanism
  computerDisplayName    String?
  osVersion              String?
  architecture           String?
  capabilities           Json?
  pendingCount           Int       @default(0)
  failedCount            Int       @default(0)
  lastSuccessfulUploadAt DateTime?
  lastErrorCategory      String?
  updateChannel          String    @default("stable")
  lastUpdateCheckAt      DateTime?
  createdWithPairingId   String?   @unique

  imagingStudies     ImagingStudy[]
  bindings           ImagingBridgeBinding[]
  createdWithPairing ImagingBridgePairing?  @relation("PairingCreatedAgent", fields: [createdWithPairingId], references: [id])

  @@index([clinicId])
}

// Short-lived, single-use pairing session created from the authenticated web
// app and redeemed once by the Windows Manager app. Plaintext code is never
// stored — only an HMAC-SHA256 hash (server-side pepper, see codeHash below).
model ImagingBridgePairing {
  id            String    @id @default(uuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  createdById   String
  createdBy     User      @relation("ImagingBridgePairingCreator", fields: [createdById], references: [id])
  codeHash      String    @unique // HMAC-SHA256(code, IMAGING_BRIDGE_PAIRING_PEPPER)
  status        String    @default("pending") // pending | redeemed | expired | cancelled | locked
  expiresAt     DateTime
  usedAt        DateTime?
  cancelledAt   DateTime?
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  bridgeName    String
  bridgeAgentId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  devices      ImagingBridgePairingDevice[]
  createdAgent ImagingBridgeAgent?          @relation("PairingCreatedAgent")

  @@index([clinicId])
  @@index([expiresAt])
}

model ImagingBridgePairingDevice {
  id        String               @id @default(uuid())
  pairingId String
  pairing   ImagingBridgePairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  deviceId  String
  modality  String
  createdAt DateTime             @default(now())

  @@unique([pairingId, deviceId])
}

// Represents one imaging device connected through an installed bridge agent.
// Local folder paths are intentionally NOT stored server-side.
model ImagingBridgeBinding {
  id                String             @id @default(uuid())
  clinicId          String
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  bridgeAgentId     String
  bridgeAgent       ImagingBridgeAgent @relation(fields: [bridgeAgentId], references: [id])
  deviceId          String
  modality          String
  displayName       String
  acquisitionType   String             @default("folder_watch")
  status            String             @default("pending") // pending | active | error | disabled
  lastValidatedAt   DateTime?
  lastErrorCategory String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([bridgeAgentId, deviceId])
  @@index([clinicId])
}

model ImagingImage {
  id             String       @id @default(uuid())
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  studyId        String
  study          ImagingStudy @relation(fields: [studyId], references: [id])
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  filePath       String // depolama anahtarı (fileStorage.ts) — asla public URL üretilmez
  sopInstanceUid String? // DICOM-uyumluluk için; manuel yüklemede boş kalır
  createdAt      DateTime     @default(now())

  /// See PatientAttachment.storageVerifiedMissingAt — same semantics, set by
  /// the orphan-check inspection when the physical file is missing.
  storageVerifiedMissingAt DateTime?

  /// F4-IMAGING-001-R6 — AUTHORITATIVE PER-OBJECT STORAGE PLACEMENT.
  ///
  /// Which storage backend actually accepted this object's bytes. Accepted
  /// values are exactly the two tokens of `ImagingStorageBackend` in
  /// services/imagingRemoteStorage.ts — `'legacy'` and `'vps2'` — reused
  /// verbatim rather than re-cased, so there is one vocabulary for "which
  /// imaging backend", not two that can drift apart. A `String?` and not a
  /// Prisma enum, matching this schema's convention for closed vocabularies
  /// (gender / patientStatus / source / pregnancyStatus / bloodGroup); see
  /// the Patient.bloodGroup comment for the full reasoning.
  ///
  /// `NULL` means "written before this column existed" (pre-R6), NOT "unknown
  /// backend". It is interpreted as `'legacy'`, deterministically and without
  /// consulting IMAGING_STORAGE_BACKEND — see
  /// resolveImagingStoragePlacement() in services/imagingRemoteStorage.ts,
  /// which is the single authoritative interpreter of this column. That is
  /// correct for every row that exists at migration time: VPS2 imaging
  /// storage has never been activated in production (F4-IMAGING-001-R5
  /// evidence §5-§6, STORAGE_MODE = SYNTHETIC_STAGING_ONLY), so no persisted
  /// row's bytes can be anywhere but legacy storage.
  ///
  /// This column exists because global runtime configuration is not a valid
  /// proxy for historical object placement (R5 Finding B): without it,
  /// unsetting IMAGING_STORAGE_BACKEND after the first VPS2 write silently
  /// reclassifies those objects as legacy and makes them unreadable. The
  /// write path persists the backend that actually accepted the bytes; the
  /// read/exists/delete/backup paths consult this column, never the flag.
  ///
  /// It is a logical placement label only. It never holds an endpoint, a
  /// bucket name, a region, a URL or any credential — those stay in
  /// environment configuration (KVKK/secret-hygiene requirement).
  storageBackend String?

  @@index([clinicId, studyId])
}

/// KVKK lifecycle (docs/compliance/53): short-lived, downloadable ZIP package
/// generated by POST /patients/:id/privacy/export-package. Follows the same
/// token-hash + expiry pattern as PublicBookingNoticeEvidence — the raw
/// download token is returned once and never persisted, only its SHA-256
/// hash. Rows (and their physical ZIP file) are deleted by a dedicated
/// cleanup job once expiresAt has passed, regardless of downloadedAt — this
/// is a short-lived transfer artifact, not an audit record. The durable
/// record of a download is the AuditLog entry written at download time.
model PatientPrivacyExportArchive {
  id                String @id @default(uuid())
  organizationId    String
  clinicId          String
  clinic            Clinic @relation(fields: [clinicId], references: [id])
  patientId         String
  requestedByUserId String
  requestedByUser   User   @relation("PrivacyExportRequester", fields: [requestedByUserId], references: [id])

  /// Lifecycle state: queued -> generating -> ready | failed. A row is
  /// created with status="generating" BEFORE the (potentially slow) ZIP
  /// build starts, so a concurrent request for the same clinic can be
  /// rejected with 409 rather than racing to build two exports at once. Rows
  /// older than the in-flight staleness window (see
  /// patientPrivacyExportPackage.ts) are treated as abandoned/failed, not as
  /// a permanent lock.
  status String @default("ready")

  /// Storage key under exports/<clinicId>/<uuid>.zip (fileStorage.ts) —
  /// never serialized to any API response. Null while status="generating".
  storageKey   String?
  /// Manifest described in docs/compliance/53 (exportVersion, includedFiles
  /// w/ sha256, missingFiles, skippedFiles). Null while status="generating".
  manifestJson Json?

  /// SHA-256 hash of the opaque one-time download token. Raw token is
  /// returned once to the caller and never persisted. Null while
  /// status="generating".
  tokenHash String? @unique

  expiresAt    DateTime?
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Lease/heartbeat (replaces createdAt-based staleness — an export can
  /// legitimately run for a long time up to EXPORT_MAX_TOTAL_SIZE_BYTES).
  /// heartbeatAt is renewed periodically by the running generation; the
  /// stale sweep in reserveGenerationSlot only fails a row once
  /// leaseExpiresAt has passed, never merely because it is old.
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?

  @@index([clinicId, patientId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([clinicId, status])
  @@index([clinicId, status, leaseExpiresAt])
}

/// KVKK-HIGH-004 (docs/compliance/54): clinic-scoped structured-data bulk export.
/// OWNER/ORG_ADMIN only, step-up authenticated, feature-flagged off by default,
/// asynchronously generated and streamed. Never contains physical
/// attachment/imaging bytes (see docs/compliance/54 scope decision).
///
/// Lifecycle: queued -> generating -> ready -> expired, or -> failed at any
/// point before ready. "expired" is a real stored terminal status, never
/// derived ad hoc from expiresAt — every route that reads this row (status,
/// download-token issuance, download) calls the single shared
/// expireArchiveIfPastTtl() helper first, so a ready row past its expiresAt
/// is always caught synchronously, regardless of whether the 15-minute
/// cleanup cron has run yet (cleanup-cron timing must never be part of the
/// security decision — see clinicBulkExportPackage.ts).
///
/// Exactly one queued/generating row may exist per clinic at a time. This is
/// enforced twice: (1) an advisory-lock-guarded reservation transaction in
/// application code, and (2) as the final invariant, a hand-written partial
/// unique index added via raw SQL in the migration (Prisma schema has no
/// first-class partial-unique-index syntax without an unstable preview
/// feature):
///   CREATE UNIQUE INDEX "ClinicBulkExportArchive_one_active_per_clinic"
///   ON "ClinicBulkExportArchive" ("clinicId")
///   WHERE status IN ('queued', 'generating');
/// See migration 20260716120000_clinic_bulk_export for the raw SQL and
/// docs/compliance/54 for the fresh-DB drift validation notes.
///
/// Storage-object deletion is deliberately NOT part of the same operation as
/// the ready->expired status transition (a Postgres transaction cannot span
/// an S3/local filesystem delete). artifactDeletedAt/cleanupFailureCode
/// track that separate, retryable step — see clinicBulkExportPackage.ts.
model ClinicBulkExportArchive {
  id                String  @id @default(uuid())
  organizationId    String
  clinicId          String
  clinic            Clinic  @relation(fields: [clinicId], references: [id])
  /// Nullable + SetNull (not a required relation): archive/audit history must
  /// survive the requesting user being deactivated/deleted later.
  requestedByUserId String?
  requestedByUser   User?   @relation("ClinicBulkExportRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  /// The user whose password most recently satisfied step-up for THIS
  /// archive (creation, or a fresh re-verification at download-token
  /// issuance). Binds the STEP_UP_WINDOW_MS reuse window to a specific
  /// actor — download-token issuance without a fresh password is only
  /// permitted when the current authenticated user matches this field AND
  /// stepUpVerifiedAt is still within the window. A different OWNER/
  /// ORG_ADMIN may still obtain a token, but only after verifying their OWN
  /// current password (which then overwrites both fields). Nullable +
  /// SetNull so archive history survives the verifying user being
  /// deactivated/deleted — a null value can never satisfy passwordless
  /// window reuse for anyone.
  stepUpVerifiedByUserId String?
  stepUpVerifiedByUser   User?   @relation("ClinicBulkExportStepUpVerifier", fields: [stepUpVerifiedByUserId], references: [id], onDelete: SetNull)

  status String @default("queued") // queued | generating | ready | failed | expired

  purpose        String // regulatory_request | clinic_migration | contract_termination | legal_request | other
  /// Internal note only. Never copied into AuditLog, OperationalEvent, or any log line.
  restrictedNote String?

  exportSchemaVersion Int @default(1)

  /// Object-storage key under exports/<clinicId>/<uuid>.zip. Never serialized
  /// to any API response. Preserved (not nulled) on a failed storage-delete
  /// attempt so the next cleanup run can retry — see cleanupFailureCode.
  storageKey   String?
  /// Manifest (see docs/compliance/54): schemaVersion, entityCounts,
  /// fileNames, sha256PerFile, scopeDescription. Only ever written for a
  /// successfully completed job — never partially written on failure.
  manifestJson Json?

  /// SHA-256 hash of the opaque one-time download token. Raw token is
  /// returned once and never persisted. Issuance is atomic: guarded by
  /// status='ready' AND downloadTokenHash IS NULL so exactly one concurrent
  /// issuance request can win (see clinicBulkExportPackage.ts).
  downloadTokenHash String? @unique

  /// Server-recorded step-up timestamp (creation time, or refreshed at
  /// download-token issuance if a fresh password was supplied). Never a
  /// client-supplied timestamp — see STEP_UP_WINDOW_MS in passwordStepUp.ts.
  stepUpVerifiedAt DateTime?

  expiresAt    DateTime?
  downloadedAt DateTime?

  /// Set once the storage object has actually been deleted (separate,
  /// retryable step from the ready->expired status transition).
  artifactDeletedAt  DateTime?
  /// Set when a storage-delete attempt fails, so the next cleanup run knows
  /// to retry using the still-present storageKey rather than assuming the
  /// object is gone. Cleared once deletion succeeds. Stable code only
  /// (e.g. "STORAGE_DELETE_FAILED") — never raw exception text.
  cleanupFailureCode String?

  /// Lease/heartbeat — an abandoned generating row (crashed worker) becomes
  /// failed once leaseExpiresAt passes, never merely because it is old.
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?

  /// Stable failure code only (e.g. "SIZE_LIMIT_EXCEEDED", "LEASE_EXPIRED",
  /// "GENERATION_ERROR"). Never raw exception text, SQL, or a local path.
  failureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, clinicId])
  @@index([clinicId, status])
  @@index([requestedByUserId, createdAt])
  @@index([stepUpVerifiedByUserId])
  @@index([expiresAt])
  @@index([leaseExpiresAt])
  @@index([clinicId, status, leaseExpiresAt])
}

/// KVKK-HIGH-004 step-up brute-force lockout — PostgreSQL-authoritative.
/// Every check-and-increment for a given (userId, clinicId, ipHash) key is
/// serialized with pg_advisory_xact_lock (same key-derivation shape as
/// appointmentRequestSafety.ts) acquired BEFORE reading/creating the row, so
/// concurrent first-attempts for a brand-new key cannot race. Redis
/// (createRateLimiter) may add an optional fast pre-check ahead of this
/// table, but this table is the single source of truth for lockout state —
/// never a second independent counter. ipHash is HMAC-SHA256 of the client
/// IP keyed by the dedicated CLINIC_BULK_EXPORT_IP_HASH_SECRET (never the
/// raw IP, never a shared/reused app secret). Rows untouched for >30 days
/// are deleted by the cleanup job.
model ClinicBulkExportPasswordAttempt {
  id              String    @id @default(uuid())
  userId          String
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  ipHash          String
  attemptCount    Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, clinicId, ipHash])
  @@index([updatedAt])
}

// ── KVKK-CRIT-003: Security Incident Response Foundation ────────────────────
//
// This is a TECHNICAL foundation only. It does not constitute legal approval
// of breach classification, notification obligations/deadlines/recipients,
// legal wording, or regulator/data-subject communication — see
// docs/compliance/55-kvkk-security-incident-response-foundation.md.
//
// Three models, three distinct jobs — never merge them:
//   SecuritySignalEvent      — append-only raw detection evidence. Never
//                              mutated. What windowed-threshold counting
//                              reads FROM.
//   SecurityIncident         — the mutable, deduplicated aggregate a
//                              Platform Admin actually works. incidentKey
//                              is unique so concurrent identical signals
//                              can only ever produce one row (DB-level
//                              upsert, never find-then-create).
//   SecurityIncidentActivity — immutable per-incident history. Only ever
//                              inserted, in the same transaction as the
//                              SecurityIncident row it documents.

/// Append-only raw security-signal evidence. Deliberately NOT layered onto
/// the existing OperationalEvent model: OperationalEvent.organizationId is a
/// required (non-nullable) column depended on by 8+ existing org-scoped call
/// sites and the clinic-facing /api/ops/events route, but some security
/// signals (a Platform Admin login failure, a cross-tenant probe with no
/// resolvable target org) have no natural single organizationId — forcing
/// them through OperationalEvent would mean either a risky nullability
/// change to a widely-depended-on column or a fake placeholder org id, both
/// worse than a dedicated table. Never contains secrets, tokens, raw IPs, or
/// patient content — see securitySignalService.ts's allowlist sanitizer.
model SecuritySignalEvent {
  id String @id @default(uuid())

  signalType String // e.g. "auth_login_failed", "clinic_scope_denied", "export_step_up_lockout"
  category   String
  severity   String
  ruleKey    String

  organizationId String?
  clinicId       String?

  actorUserId          String?
  actorPlatformAdminId String?

  /// HMAC-SHA256(SECURITY_SIGNAL_IP_HASH_SECRET, ip) — never a raw IP.
  ipHash               String?
  /// Bounded/normalized user-agent fingerprint (hashed) — never the raw header.
  userAgentFingerprint String?

  resourceType String?
  /// HMAC-hashed or otherwise safe resource identifier — never a raw guessed id.
  resourceId   String?

  /// Grouping key used to compute a durable windowed occurrence count for
  /// threshold-based rules (e.g. an account-identifier hash, an ipHash, or a
  /// resource-scope hash) — see securitySignalService.ts.
  dedupeDimension String

  /// Sanitized metadata only — allowlist-checked, see securitySignalService.ts.
  safeMetadata Json?

  createdAt DateTime @default(now())

  @@index([ruleKey, dedupeDimension, createdAt])
  @@index([organizationId, createdAt])
  @@index([clinicId, createdAt])
  @@index([createdAt])
}

/// Durable, deduplicated security incident record — the mutable aggregate a
/// Platform Admin actually triages and works. legalReviewRequired/
/// legalReviewStatus are technical placeholders recording that a human
/// legal decision is pending; they are never set by this feature to imply a
/// legal conclusion, classification, or notification deadline — see the
/// runbook. onDelete: SetNull throughout so a deleted/deactivated Platform
/// Admin never destroys incident history.
model SecurityIncident {
  id String @id @default(uuid())

  /// Deterministic dedupe key derived from sourceRule + scope + affected
  /// resource (see securitySignalService.ts buildIncidentKey). Unique at the
  /// DB level so concurrent identical signals can only ever upsert the SAME
  /// row — never a race-prone find-then-create.
  incidentKey String @unique

  organizationId String?
  clinicId       String?

  category String // auth_brute_force | cross_tenant_access | export_anomaly | webhook_signature
  severity String // low | medium | high | critical
  status   String @default("open") // open | acknowledged | investigating | contained | resolved | closed | false_positive

  title   String
  summary String

  firstDetectedAt DateTime
  lastDetectedAt  DateTime
  occurrenceCount Int      @default(1)

  sourceType String // e.g. "auth_login", "clinic_scope_denial", "clinic_bulk_export"
  sourceRule String // stable rule key, e.g. "auth.brute_force.v1"

  affectedResourceType String?
  affectedResourceId   String?

  assignedToPlatformAdminId String?
  assignedToPlatformAdmin   PlatformAdmin? @relation("SecurityIncidentAssignee", fields: [assignedToPlatformAdminId], references: [id], onDelete: SetNull)

  acknowledgedAt                DateTime?
  acknowledgedByPlatformAdminId String?
  acknowledgedByPlatformAdmin   PlatformAdmin? @relation("SecurityIncidentAcknowledger", fields: [acknowledgedByPlatformAdminId], references: [id], onDelete: SetNull)

  containedAt                DateTime?
  containedByPlatformAdminId String?
  containedByPlatformAdmin   PlatformAdmin? @relation("SecurityIncidentContainer", fields: [containedByPlatformAdminId], references: [id], onDelete: SetNull)

  resolvedAt                DateTime?
  resolvedByPlatformAdminId String?
  resolvedByPlatformAdmin   PlatformAdmin? @relation("SecurityIncidentResolver", fields: [resolvedByPlatformAdminId], references: [id], onDelete: SetNull)

  closedAt                DateTime?
  closedByPlatformAdminId String?
  closedByPlatformAdmin   PlatformAdmin? @relation("SecurityIncidentCloser", fields: [closedByPlatformAdminId], references: [id], onDelete: SetNull)

  resolutionSummary  String?
  containmentSummary String?

  /// Technical placeholder only, default true. Never flipped by any
  /// automated detection code — only ever changed via an explicit Platform
  /// Admin action (recorded in SecurityIncidentActivity), and even then this
  /// is not a legal determination.
  legalReviewRequired Boolean @default(true)
  legalReviewStatus   String  @default("pending") // pending | in_review | not_required | advised

  /// Safe, sanitized metadata only — same allowlist as SecuritySignalEvent.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity SecurityIncidentActivity[]

  @@index([status, severity, lastDetectedAt])
  @@index([organizationId, status])
  @@index([clinicId, status])
  @@index([category, lastDetectedAt])
  @@index([assignedToPlatformAdminId, status])
}

/// Immutable incident lifecycle history — only ever created, never updated
/// or deleted, and always inserted in the same DB transaction as the
/// SecurityIncident row it documents. Never contains secrets or patient
/// content — same allowlist/sanitizer as SecuritySignalEvent.
model SecurityIncidentActivity {
  id         String           @id @default(uuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id])

  action         String // created | occurrence_recorded | severity_escalated | acknowledged | investigating | assigned | contained | resolved | closed | false_positive | reopened | note_added
  previousStatus String?
  newStatus      String?

  actorPlatformAdminId String?
  actorPlatformAdmin   PlatformAdmin? @relation("SecurityIncidentActivityActor", fields: [actorPlatformAdminId], references: [id], onDelete: SetNull)

  note     String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
}

// ─── File Backup Coverage (FILE-BACKUP-COVERAGE-001) ───────────────────────
// Off-host replication ledger for filesystem-backed clinical artifacts
// (patient attachments, lab-order attachments, imaging images). Additive
// only: does NOT modify PatientAttachment/LabOrderAttachment/ImagingImage/
// ImagingStudy, does not rename or move any existing fileStorage.ts
// storageKey, and the backup job never deletes or mutates a source file.
// See docs/program/evidence/FILE_BACKUP_COVERAGE_001.md.

/// One row per backup job execution. Append-only history — a run is never
/// deleted, so this table is also the durable evidence trail for "was a
/// backup ever run" (mirrors the concern R-032 raised for the DB restore
/// test, applied here to file backup/restore).
model FileBackupRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | completed | failed
  trigger    String    @default("scheduled") // scheduled | manual

  filesScanned  Int    @default(0)
  filesCopied   Int    @default(0)
  filesVerified Int    @default(0)
  filesSkipped  Int    @default(0) // already backed up in a prior run, checksum unchanged
  filesFailed   Int    @default(0)
  filesMissing  Int    @default(0) // DB row present, source physical file not found
  bytesCopied   BigInt @default(0)

  errorSummary String?
  manifestKey  String? // off-host manifest object key for this run, if written

  entries FileBackupEntry[]

  @@index([status, startedAt])
}

/// One row per source file considered by a FileBackupRun. Immutable once
/// written (a file already `verified` in an earlier run is recorded again as
/// `skipped_unchanged` in a later run, never mutated in place) so the ledger
/// stays a durable per-run audit trail, not just current state.
model FileBackupEntry {
  id    String        @id @default(uuid())
  runId String
  run   FileBackupRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  sourceModel    String // PatientAttachment | LabOrderAttachment | ImagingImage
  sourceRecordId String
  clinicId       String
  sourceKey      String // existing fileStorage.ts storage key — read-only, never modified
  destinationKey String // off-host backup destination key

  sourceChecksumSha256      String?
  destinationChecksumSha256 String?
  sourceSizeBytes           Int?

  status       String // copied | verified | skipped_unchanged | failed | missing_source
  errorMessage String?

  copiedAt   DateTime?
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([runId, status])
  @@index([clinicId])
  @@index([sourceModel, sourceRecordId])
}

// ─── Recovery Drill Evidence (F4-FCR-001) ──────────────────────────────────
// Durable evidence trail for recovery exercises (database restore tests and
// file restore rehearsals). Purely additive: does NOT modify FileBackupRun,
// FileBackupEntry, or any other existing model, and nothing in this table is
// tenant-scoped — a recovery drill is a platform-level operation, never a
// per-clinic one.

/// One row per recovery drill execution. This is the durable RPO/RTO
/// evidence trail: before this model existed, a restore test proved only
/// "restore works right now" in a log line that scrolled away — there was no
/// queryable record of WHEN the last successful drill ran, HOW LONG recovery
/// took (RTO), or HOW OLD the artifact it recovered from was (RPO).
///
///   - `durationMs` is the measured RTO evidence for one drill.
///   - `sourceArtifactAt` / `sourceArtifactAgeMinutes` are the RPO evidence:
///     the age, at drill start, of the newest backup artifact the drill
///     actually exercised.
///   - `cleanupVerified` / `residualArtifact` close the loop on the drill's
///     own side effects — a drill that restores into a scratch database or a
///     temp directory must be provably able to say it cleaned up after
///     itself, not merely assumed to have done so.
///
/// Append-only history — a drill run row is never deleted, so "was a
/// recovery drill ever actually run, and when" stays answerable
/// indefinitely. Mirrors FileBackupRun's append-only evidence convention.
model RecoveryDrillRun {
  id String @id @default(uuid())

  /// db_restore_test | file_restore_rehearsal
  kind    String
  /// scheduled | manual | cli
  trigger String @default("scheduled")
  /// running | passed | failed. A row left in `running` after a crash is
  /// swept to `failed` with errorCode `drill_abandoned` by
  /// reapStaleRecoveryDrills() — see recoveryDrillService.ts.
  status  String @default("running")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RTO evidence: finishedAt - startedAt, in milliseconds. Null for a run
  /// that never finished (crashed/abandoned), which is itself the signal.
  durationMs Int?

  /// The backup artifact this drill recovered FROM: the dump file's mtime
  /// for a db_restore_test, or the newest exercised FileBackupEntry's
  /// copiedAt for a file_restore_rehearsal.
  sourceArtifactAt         DateTime?
  /// RPO evidence: drill start - sourceArtifactAt, in minutes. This is the
  /// real, measured data-loss window a recovery from that artifact would
  /// have incurred — not a policy target.
  sourceArtifactAgeMinutes Int?

  samplesAttempted Int @default(0)
  samplesPassed    Int @default(0)
  samplesFailed    Int @default(0)

  /// True only when the drill positively confirmed its own scratch
  /// artifacts were removed. Defaults to false so "we never checked" and
  /// "we checked and it failed" are never confused with success.
  cleanupVerified  Boolean @default(false)
  /// Non-sensitive operator-actionable label of anything cleanup failed to
  /// remove — most importantly a LEAKED TEMPORARY DATABASE NAME, e.g.
  /// `noramedi_restore_test_1723545600000_ab12cd34`. That string is
  /// deliberately safe to persist and to show an operator: it contains no
  /// PHI, no patient identifier, no clinic identifier and no secret — it is
  /// a generated scratch name — and an operator NEEDS it verbatim to go
  /// drop the leftover database by hand. Never put a file name, storage
  /// key, absolute path, clinic id, or raw error message here.
  residualArtifact String?

  /// Sanitized failure classification only (safeErrorFields().errorCode
  /// style, or a fixed label such as `drill_abandoned`). Never a raw error
  /// message — raw messages embed absolute paths and endpoints.
  errorCode String?
  createdAt DateTime @default(now())

  @@index([kind, startedAt])
  @@index([status, startedAt])
}

// ── External Calendar Integration Framework (DigiDentiS + future providers) ──
// See docs/architecture/external-calendar-integration.md for the full design.
// Provider-agnostic by construction: `provider` is a free-form key (starts
// with "digidentis"), never assumed to be DigiDentiS-only in shape.

/// Platform-admin-configured external dental-software calendar integration.
/// One row per clinic (a clinic runs exactly one active integration at a
/// time — mirrors ClinicSmsSettings' clinicId @unique pattern). Credentials
/// are encrypted at rest (utils/encryption.ts encryptSecret) and are
/// write-only from the API: GET responses only ever report
/// configured/not-configured booleans, never ciphertext or plaintext.
/// Disabled by default — `enabled` must be explicitly turned on by a
/// Platform Admin after mappings are configured.
model ExternalCalendarIntegration {
  id             String @id @default(uuid())
  organizationId String
  clinicId       String @unique
  clinic         Clinic @relation(fields: [clinicId], references: [id])

  /// digidentis | (future provider keys)
  provider String  @default("digidentis")
  /// Platform Admin master switch. Never auto-enabled by any job or webhook.
  enabled  Boolean @default(false)
  /// not_configured | configured | connected | error
  status   String  @default("not_configured")

  /// DigiDentiS OAuth2 client id. Not classified as a secret, but never
  /// returned in full by the admin API (last-4 hint only).
  clientId               String?
  /// AES-256-GCM (utils/encryption.ts encryptSecret). Write-only from the API.
  clientSecretEncrypted  String?
  /// AES-256-GCM (utils/encryption.ts encryptSecret). HMAC key used to verify
  /// inbound DigiDentiS webhook signatures. Write-only from the API.
  webhookSecretEncrypted String?
  /// Opaque, random, per-clinic token used ONLY as the public webhook URL's
  /// path segment — deliberately never this row's own database id, so the
  /// URL exposes no predictable/enumerable identifier and can be rotated
  /// (regenerated) independently of the integration row itself. Generated
  /// app-side with crypto.randomBytes (see externalCalendarConnectionService.ts).
  webhookReceiverKey     String  @unique

  /// DigiDentiS-side company/clinic identifiers this row maps to.
  externalCompanyId String?
  externalClinicId  String?
  /// Optional per-clinic API base URL override (e.g. DigiDentiS sandbox).
  apiBaseUrl        String?

  lastSuccessfulCheckAt DateTime?
  lastCheckedAt         DateTime?
  /// Last connectivity/auth error, sanitized (never includes secrets/tokens).
  lastError             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings         ExternalCalendarMapping[]
  inboundEvents    ExternalCalendarInboundEvent[]
  appointmentLinks ExternalCalendarAppointmentLink[]

  @@index([organizationId])
  @@index([provider])
}

/// Persistent, id-based mapping between a NoraMedi practitioner/service and a
/// provider-side doctor/treatment type. Matching is NEVER done by name at
/// runtime — see externalCalendarMappingService.ts resolveMapping(), which
/// blocks synchronization with an administrative error when a mapping is
/// missing or inactive.
model ExternalCalendarMapping {
  id             String                      @id @default(uuid())
  connectionId   String
  connection     ExternalCalendarIntegration @relation(fields: [connectionId], references: [id])
  organizationId String
  clinicId       String

  /// practitioner | service
  mappingType   String
  /// NoraMedi User.id (practitioner) or AppointmentType.id (service)
  localId       String
  /// Provider-side doctor id or treatment type id
  externalId    String
  /// Cached display label from the provider, for the admin UI only — never
  /// used for matching.
  externalLabel String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, mappingType, localId])
  @@index([clinicId])
  @@index([connectionId, mappingType])
}

/// Idempotent inbound webhook ledger for external calendar providers —
/// mirrors MessagingInboundEvent's dedupe-by-unique-constraint pattern.
/// Reserved/unknown event types are stored here without applying any domain
/// change — see externalCalendarWebhookProcessor.ts.
model ExternalCalendarInboundEvent {
  id             String                       @id @default(uuid())
  provider       String
  connectionId   String?
  connection     ExternalCalendarIntegration? @relation(fields: [connectionId], references: [id])
  clinicId       String?
  organizationId String?

  /// appointment.created | appointment.cancelled | appointment.rescheduled |
  /// any other provider event type (stored verbatim, treated as reserved/unknown)
  eventType             String
  /// Dedupe key: the provider's own event id, or a deterministic fallback
  /// derived from the payload when the provider omits one.
  providerEventId       String
  externalAppointmentId String?
  rawPayload            Json?

  /// received | processing | processed | ignored | failed
  status       String    @default("received")
  errorMessage String?
  attempts     Int       @default(0)
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, connectionId, providerEventId])
  @@index([organizationId, status, createdAt])
  @@index([clinicId, status, createdAt])
  @@index([status, updatedAt])
}

/// Stable NoraMedi ⇄ provider appointment reference plus the outbound-create
/// idempotency ledger (a retried create request must never double-book a
/// provider-side appointment). Phase 2 wires this into the AppointmentRequest
/// conversion flow — see externalCalendarOutboundSync.ts. One row is created
/// per converted Appointment when the clinic has an enabled integration, and
/// its `status`/`attempts`/`nextAttemptAt` drive the immediate sync attempt,
/// the bounded retry job, and manual staff retries — all three funnel through
/// the same atomic claim (status transition guarded by a conditional
/// updateMany) so they can never process the same row concurrently.
model ExternalCalendarAppointmentLink {
  id             String                      @id @default(uuid())
  connectionId   String
  connection     ExternalCalendarIntegration @relation(fields: [connectionId], references: [id])
  organizationId String
  clinicId       String

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  /// Set once the provider confirms creation — null while pending/syncing/failed.
  externalAppointmentId String?
  /// Client-generated idempotency key sent to the provider on every create
  /// attempt (as X-Idempotency-Key) — deterministic per appointment (see
  /// computeOutboundSyncIdempotencyKey()) so retries and duplicate conversion
  /// requests can never create a second provider-side appointment.
  idempotencyKey        String

  /// pending | syncing | synced | failed_retryable | failed_terminal | cancelled
  /// (outbound lifecycle) — see externalCalendarOutboundSync.ts header comment.
  /// "active | cancelled | rescheduled" from the original design doc collapses
  /// into this same field once a row is synced: 'synced' plays the role
  /// "active" would have played for a freshly created appointment link.
  status        String    @default("pending")
  /// Attempts already made (immediate + retry job + manual retry all
  /// increment this atomically as part of the claim). Compared against the
  /// job's MAX_ATTEMPTS to classify retry exhaustion as failed_terminal.
  attempts      Int       @default(0)
  /// Backoff floor: the retry job only claims a failed_retryable row once
  /// now() >= nextAttemptAt. Null means "claimable as soon as picked up"
  /// (fresh pending rows, or immediately after a manual retry request).
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  /// Set only on a successful create — the moment the row reaches 'synced'.
  lastSyncedAt  DateTime?
  /// Sanitized, human-readable failure summary for staff — never the raw
  /// provider response body (which may echo back patient data) and never
  /// secrets/credentials. See classifyExternalCalendarSyncError().
  lastError     String?
  /// Machine-readable failure classification, e.g. AUTH_ERROR,
  /// MAPPING_MISSING, VALIDATION_ERROR, SLOT_NOT_AVAILABLE, RATE_LIMITED,
  /// TRANSIENT, NOT_CONFIGURED. Null while pending/syncing/synced.
  errorCode     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, externalAppointmentId])
  @@index([clinicId])
  @@index([appointmentId])
  @@index([status, nextAttemptAt])
}

// =============================================================================
// F3-DATA-MIG-TODAY-001 — Platform Admin clinic data migration
// =============================================================================
// Additive only (expand-migrate-contract). No existing model is altered
// destructively; the only changes to existing models are three NULLABLE
// Patient scalars (gender, chartNumber, primaryPractitionerId) plus
// back-relations, all with zero backfill.
//
// This whole block is PLATFORM ADMIN ONLY. Nothing here is reachable from a
// clinic-authenticated session. The existing basic clinic patient importer
// (routes/patientsImport.ts) is RETAINED / OUT_OF_SCOPE / UNCHANGED and shares
// none of these models.
//
// Status / enum-like columns are plain String with the allowed values in a
// /// doc-comment, following the repo-wide convention (Patient.patientStatus,
// PatientEmergencyContact.contactType, Appointment.status, ...). No Prisma
// enum is introduced.

/// F3-DATA-MIG-TODAY-001 - One Platform-Admin-initiated clinic data migration
/// run. Owns the run lifecycle state machine, the uploaded source file's safe
/// metadata, the dry-run summary and the final reconciliation.
///
/// status (state machine - server/src/services/migration/runState.ts is
/// authoritative; illegal transitions are rejected with MIGRATION_STATE_INVALID):
///   CREATED | UPLOADED | ANALYZED | MAPPING_REQUIRED | MAPPING_READY
///   | DRY_RUN_RUNNING | DRY_RUN_COMPLETE | BLOCKED | READY | RUNNING
///   | PARTIAL_FAILURE | COMPLETED | FAILED | CANCELLED
///
/// sourceFileStoredPath is a server-local, non-public, run-scoped path under
/// server/.tmp/migration-source/<runId>/ - never served over HTTP, never under
/// uploads/, and deleted by retention (sourceFileDeletedAt). The original
/// filename is NEVER used to build the path (traversal-proof by construction);
/// only a sanitized display form is retained.
model MigrationRun {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic       @relation("MigrationRunClinic", fields: [clinicId], references: [id])

  /// Stable vendor/profile identifier, e.g. "legacy-dental-tr-v1". Part of the
  /// provenance identity together with organizationId + sourceEntity + sourceId.
  sourceSystem   String
  /// Mapping-profile version this run was executed under.
  profileVersion String @default("v1")
  /// patient (the only entity in scope today). Declared so the domain is not
  /// designed around one spreadsheet: practitioner | service | appointment |
  /// treatment_case | procedure | payment remain BLOCKED - no source data.
  entityType     String @default("patient")

  status String @default("CREATED")

  /// Sanitized display filename. NEVER used to build a filesystem path.
  sourceFileNameSafe   String?
  /// xls | xlsx - determined by BINARY SIGNATURE, never by extension or MIME.
  sourceFileFormat     String?
  sourceFileSizeBytes  Int?
  sourceFileSha256     String?
  sourceFileStoredPath String?
  sourceFileDeletedAt  DateTime?

  sheetName         String?
  sheetIndex        Int?
  totalSourceRows   Int?
  headerColumnCount Int?
  /// Non-blocking analysis warnings, e.g. hidden sheets, empty leading column.
  analysisWarnings  Json?

  batchSize    Int @default(500)
  totalBatches Int @default(0)
  currentBatch Int @default(0)

  processedRows Int @default(0)
  createdRows   Int @default(0)
  matchedRows   Int @default(0)
  skippedRows   Int @default(0)
  failedRows    Int @default(0)
  warningRows   Int @default(0)
  blockedRows   Int @default(0)

  /// Full dry-run report (counts, blockers, plan limits, identity
  /// classifications). Aggregates only - NEVER row values, NEVER PII/PHI.
  dryRunSummary    Json?
  /// Deterministic post-execution reconciliation. Aggregates only.
  reconciliation   Json?
  /// Safe typed error code for a FAILED/BLOCKED run (see failure taxonomy).
  lastErrorCode    String?
  /// Safe, human-readable message. NEVER a raw DB exception, NEVER PII.
  lastErrorMessage String?

  /// Held by the process currently executing this run. A conditional UPDATE on
  /// (id, status, executionLockToken) is the cross-process mutual-exclusion
  /// primitive - a second execute request cannot acquire it.
  executionLockToken   String?
  executionLockedAt    DateTime?
  /// Refreshed between batches; a lock older than the stale threshold can be
  /// reclaimed by an explicit Platform Admin resume after a process restart.
  executionHeartbeatAt DateTime?
  /// Set by a cancel request; the executor stops scheduling further batches.
  cancelRequestedAt    DateTime?
  cancelRequestedById  String?

  createdByPlatformAdminId String?
  createdByPlatformAdmin   PlatformAdmin? @relation("MigrationRunCreator", fields: [createdByPlatformAdminId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  uploadedAt  DateTime?
  analyzedAt  DateTime?
  dryRunAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  batches         MigrationRunBatch[]
  fieldMappings   MigrationFieldMapping[]
  rowOutcomes     MigrationRowOutcome[]
  records         MigrationRecord[]               @relation("MigrationRecordCreatedByRun")
  /// F3-DATA-MIG-TODAY-001-R10. Legacy source values this run preserved.
  preservedValues MigrationPreservedSourceValue[]

  @@index([organizationId, createdAt])
  @@index([clinicId, createdAt])
  @@index([status, createdAt])
}

/// F3-DATA-MIG-TODAY-001 - Durable per-batch execution state. A run executes in
/// bounded batches with per-batch atomicity: a failure in batch N never rolls
/// back committed batches 1..N-1, and resume restarts at the first
/// non-succeeded batch.
///
/// status: PENDING | RUNNING | SUCCEEDED | FAILED | CANCELLED | SKIPPED
model MigrationRunBatch {
  id    String       @id @default(uuid())
  runId String
  run   MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  batchNumber Int
  /// Inclusive source row range (1-based data-row numbering, header excluded).
  rowStart    Int
  rowEnd      Int

  status String @default("PENDING")

  processedRows Int @default(0)
  createdRows   Int @default(0)
  matchedRows   Int @default(0)
  skippedRows   Int @default(0)
  failedRows    Int @default(0)
  warningRows   Int @default(0)

  retryCount Int @default(0)

  /// Safe typed error code - never a raw DB exception string.
  errorCode    String?
  errorSummary String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([runId, batchNumber])
  @@index([runId, status])
}

/// F3-DATA-MIG-TODAY-001 - The Platform Admin's resolved source-to-destination
/// field mapping for one run. Every source column gets exactly one row, so a
/// run can never execute with an undecided column.
///
/// state: AUTO_CONFIDENT | AUTO_REVIEW | MANUAL_REQUIRED | BLOCKED | IGNORE
///        | LEGAL_BLOCKED | RESOLVED
/// destinationField is the canonical destination key (e.g. "patient.firstName",
/// "patient.identity.tckn", "provenance.sourceId"), null when IGNORE/BLOCKED.
model MigrationFieldMapping {
  id    String       @id @default(uuid())
  runId String
  run   MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Source header EXACTLY as exported (byte-exact). Reruns re-key on this.
  sourceField      String
  /// Physical 0-based column index in the worksheet.
  sourceIndex      Int
  /// Normalized form used for matching only - never the stored key.
  sourceNormalized String
  /// TRUE when the worksheet's header CELL for this column was blank, so
  /// `sourceField` holds the synthesized `COLUMN_<sourceIndex>` name
  /// (canonicalParser.ts, UNNAMED_COLUMN_PREFIX) rather than a real vendor
  /// header. Mirrors CanonicalHeader.headerWasBlank, whose contract states
  /// that a headerless column must be identified by THIS flag and never by
  /// string-matching the synthesized name - a real vendor header could
  /// legitimately be "COLUMN_7". Persisting it is what lets the mapping API
  /// answer "does this column have an original header?" authoritatively after
  /// the workbook has been put away; without it the flag died at analyze time
  /// and every consumer was forced back onto the forbidden string match.
  /// ADDITIVE + NULLABLE: NULL means "recorded before this column existed",
  /// which readers treat as "unknown, fall back to the legacy inference", so
  /// no backfill is required and the previous application release runs
  /// unchanged against this schema.
  sourceHeaderWasBlank Boolean?

  destinationField String?
  /// Named transform contract applied between source and destination, e.g.
  /// "trim", "phone_tr", "date_excel_serial", "gender_tr", "deleted_to_status",
  /// "compose_address". Null = direct assignment after trim.
  transform        String?
  /// Ordering when several source fields compose into one destination
  /// (documented multi-source composition, e.g. MAHALLE + ADRESI -> address).
  composeOrder     Int?

  state         String  @default("MANUAL_REQUIRED")
  /// 0..100. Deterministic - produced by the rule that matched, not by a model.
  confidence    Int     @default(0)
  /// Machine-readable reason the suggestion was made, e.g. "EXACT_HEADER",
  /// "ALIAS", "NORMALIZED", "FIRST_CUSTOMER_MATRIX", "NO_DESTINATION",
  /// "LEGAL_GATE", "VENDOR_INTERNAL".
  reason        String?
  /// Aggregate source profile for this column (fill rate, distinct count,
  /// observed types). Aggregates only - NEVER sample values.
  sourceProfile Json?

  isAutoSuggested Boolean @default(false)

  decidedByPlatformAdminId String?
  decidedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, sourceField])
  @@index([runId, state])
}

/// F3-DATA-MIG-TODAY-001 (G-E2) - Explicit source-value to NoraMedi-entity
/// reference mapping, e.g. the 25 distinct HASTADOKTOR labels to User.id.
///
/// Tenant-scoped by construction. sourceValue is stored BYTE-EXACT as exported
/// (no trimming, no case folding, no Turkish-locale casing, no diacritic
/// stripping) - normalization may be computed for display/ranking but must
/// never become the stored key, or reruns silently re-key.
///
/// NO fuzzy matching, NO auto-creation of destination rows. A migration-created
/// User would be a credentialed, payable account created without an onboarding
/// decision - forbidden.
///
/// entityType: practitioner | staff_user | service | branch
/// status:     UNMAPPED | MAPPED_APPROVED | MAPPED_IGNORED | CONFLICTED
model MigrationReferenceMap {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// F3-DATA-MIG-TODAY-001-R1 - THE MAPPING IS BRANCH-SCOPED, NOT ONLY
  /// TENANT-SCOPED. In a multi-branch organization the same source label
  /// ("Dr Ayse") is two different people in two different branches: clinic A's
  /// "Dr Ayse" is User A, clinic B's is User B. An organization-only invariant
  /// silently reuses clinic A's approved mapping when clinic B is migrated and
  /// attributes every one of clinic B's patients to the wrong practitioner.
  /// The mapping is therefore keyed on the run's target clinic as well, and a
  /// destination user must be an eligible practitioner FOR THAT CLINIC
  /// (utils/relationGuards.ts findClinicPractitioner).
  clinicId String
  clinic   Clinic @relation("MigrationReferenceMapClinic", fields: [clinicId], references: [id])

  sourceSystem String
  entityType   String
  sourceValue  String

  /// Resolved destination row id (User.id for practitioner/staff_user).
  /// Null while UNMAPPED or MAPPED_IGNORED.
  destinationId String?
  status        String  @default("UNMAPPED")

  /// Approval is human and attributed. Frontend selection is not evidence.
  approvedByPlatformAdminId String?
  approvedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Names are pinned: the generated names would exceed PostgreSQL's 63-char
  // identifier limit and be truncated, which makes schema and migration SQL
  // disagree.
  @@unique([organizationId, clinicId, sourceSystem, entityType, sourceValue], map: "MigrationReferenceMap_organizationId_clinicId_sourceSystem_key")
  @@index([organizationId, clinicId, sourceSystem, entityType, status], map: "MigrationReferenceMap_organizationId_clinicId_sourceSystem_idx")
  @@index([clinicId])
}

/// F3-DATA-MIG-TODAY-001 (G-E1) - DURABLE CROSS-RUN PROVENANCE. This is the
/// idempotency anchor: it records which destination row a given source record
/// produced, independently of which run produced it.
///
/// The unique invariant is (organizationId, sourceSystem, sourceEntity,
/// sourceId) - TENANT-SCOPED, not global. A globally unique index over vendor
/// source ids would itself be a cross-tenant hazard: the same HASTA_ID in two
/// organizations is two unrelated patients and MUST NOT collide.
///
/// Rerunning the same source row therefore matches an existing record instead
/// of creating a second Patient, and a batch retry cannot duplicate.
///
/// HASTA_ID is SOURCE PROVENANCE, never a patient business identifier, and is
/// never surfaced as the patient's medical identity. Phone, email and name are
/// empirically disproven as keys (28.6 % shared phones, 25.7 % colliding names)
/// and are NEVER used for provenance or dedup.
///
/// destinationId is polymorphic by sourceEntity (Patient.id when
/// sourceEntity='patient') and deliberately carries no FK - the same table
/// serves future entity types. Reconciliation verifies resolution by query.
///
/// outcome: created | matched
///   `updated` is deliberately NOT supported in v1 - a patient-master import
///   only ever creates or matches, which keeps rollback a bounded delete over
///   `created` rows and removes the pre-image problem entirely.
model MigrationRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic       @relation("MigrationRecordClinic", fields: [clinicId], references: [id])

  sourceSystem String
  sourceEntity String
  /// The vendor's own primary key for the record - HASTA_ID for patients.
  sourceId     String

  destinationId String
  outcome       String

  /// The run that FIRST created this record. Immutable - rollback is scoped on
  /// it, so a later rerun must never overwrite it.
  createdByRunId String
  createdByRun   MigrationRun @relation("MigrationRecordCreatedByRun", fields: [createdByRunId], references: [id])
  /// The most recent run that observed this source record. Mutable.
  lastSeenRunId  String
  lastSeenAt     DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sourceSystem, sourceEntity, sourceId])
  @@index([createdByRunId, sourceEntity])
  @@index([organizationId, sourceEntity, destinationId])
  @@index([clinicId, sourceEntity])
}

/// F3-DATA-MIG-TODAY-001 - Per-run, per-row outcome. Drives the SUCCESS and
/// FAILURE XLSX reports, resume (the first non-terminal row of the first
/// non-succeeded batch), and the deterministic reconciliation.
///
/// Separate from MigrationRecord on purpose: MigrationRecord is the durable
/// cross-run identity map (one row per source record, ever), while this is the
/// per-run ledger (one row per source row, per run). Sharing one table would
/// make run A's report mutate when run B executes.
///
/// status: CREATED | MATCHED | SKIPPED | FAILED | BLOCKED | INVALID
///         | MANUAL_REVIEW | AMBIGUOUS | DUPLICATE_SOURCE | MAPPING_REQUIRED
///
/// NO RAW PII/PHI IN THIS TABLE. errorMessage is a safe, templated string;
/// sourceId is the vendor provenance key (HASTA_ID), which is operational, not
/// clinical. No name, phone, e-mail, address, note or identity value is stored.
model MigrationRowOutcome {
  id    String       @id @default(uuid())
  runId String
  run   MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 1-based data-row number (worksheet header excluded), stable across reruns.
  sourceRowNumber Int
  batchNumber     Int?
  /// HASTA_ID - provenance only.
  sourceId        String?

  status String

  /// Machine-readable result/error code from the typed failure taxonomy.
  resultCode   String?
  /// Safe, human-readable explanation. NEVER a raw DB exception, NEVER PII.
  errorMessage String?
  /// Canonical destination field the failure concerns, when field-scoped.
  fieldName    String?
  retryable    Boolean @default(false)

  /// Patient.id when the row created or matched a patient.
  destinationPatientId String?

  /// VALID | INVALID_LEGACY | AMBIGUOUS | DUPLICATE_SOURCE | MANUAL_REVIEW
  /// | ABSENT - the national-identity classification for this row. The VALUE
  /// itself is never stored here.
  identityClassification String?
  /// True when an encrypted PatientIdentityDocument was written for this row.
  identityWritten        Boolean @default(false)

  /// Non-blocking warning codes, e.g. ["GENDER_VALUE_UNRECOGNIZED",
  /// "PHONE_LEADING_ZERO_RESTORED"]. Codes only - never values.
  warnings Json?

  createdAt DateTime @default(now())

  @@unique([runId, sourceRowNumber])
  @@index([runId, status])
  @@index([runId, batchNumber])
}

/// F3-DATA-MIG-TODAY-001-R10 - CONTROLLED LEGACY SOURCE PRESERVATION.
///
/// THE PROBLEM THIS SOLVES. Measuring all 91 first-customer columns showed 10
/// that carry real rows and have no canonical destination anywhere in the
/// product - UNVANI (14,890), SUBEDOSYANO (9,105), FAX (96), MEDENIHALI (57),
/// ANNEADI (25), BABAADI (18), ALTDOSYANO (10), TURIZM (6), SIGORTATURU (2),
/// UCRETTARIFESI (1) - plus KVKKILKKODU (4,754), a vendor register key that
/// must never become consent. Before this model the only two options were
/// "invent a Patient column for each" or "drop it". Both are wrong. This is
/// the third option: keep the value, with provenance, marked as evidence.
///
/// THIS IS NOT A JSON DUMP, and the constraints are what make that true:
///   - one ROW per preserved value, not one blob per patient;
///   - `sourceColumn` names the vendor column it came from, byte-exact;
///   - `migrationRunId` names the run that wrote it, so every value is
///     traceable to an operator-approved mapping decision on a specific file;
///   - `sourceSystem` names the vendor;
///   - there is NO clinic-facing write API. The ONLY writer is the migration
///     executor, which is Platform-Admin-gated. Clinic staff can read it where
///     business-appropriate; nobody can author one by hand.
///
/// EVIDENCE, NOT CURRENT CLINICAL TRUTH. A preserved value is what the old
/// system held. It is deliberately not readable by any clinical, messaging,
/// billing or matching code path, and nothing in the product may branch on it.
/// It exists so a question about a patient's legacy record can be answered.
///
/// PRIVACY. These rows carry raw legacy PII (names of parents, phone numbers,
/// free text), so this model is wired into every patient privacy surface:
/// subject-access export, anonymization (hard delete - a preserved legacy
/// value has no clinical value to retain), clinic bulk export and data
/// retention. `sensitivity` drives that handling and is set at write time from
/// the mapping decision, never inferred later.
///
/// WHY NOT ENCRYPTED AT REST. PatientIdentityDocument encrypts because it holds
/// government identity numbers with an exhaustively-invertible key space. No
/// government identifier reaches this model: every such first-customer column
/// (TCNO aside, which has its own encrypted home) measured 0 filled rows -
/// PASAPORTNO, SOSYAL_GUVENCE_NO, ENABIZTAKIPNO, YUPASS_NO, HTS_KODU, VERGINO
/// are all empty. Adding a second crypto boundary for data that does not exist
/// would be speculative complexity; if a future source carries one, it belongs
/// in PatientIdentityDocument, not here. `sensitivity = 'RESTRICTED'` is the
/// hook that would gate such a value out of bulk export.
model MigrationPreservedSourceValue {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic       @relation("MigrationPreservedSourceValueClinic", fields: [clinicId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  /// The run that wrote this value. Cascade: deleting a run's evidence with the
  /// run is correct - the provenance is the point, and a preserved value whose
  /// run is gone can no longer be explained.
  migrationRunId String
  migrationRun   MigrationRun @relation(fields: [migrationRunId], references: [id], onDelete: Cascade)

  /// Vendor system identifier, e.g. "legacy-dental-tr-v1".
  sourceSystem    String
  /// Byte-exact vendor column name, e.g. "SUBEDOSYANO".
  sourceColumn    String
  /// 1-based row number in the source workbook, for provenance only.
  sourceRowNumber Int?
  /// The preserved value, verbatim as the parser projected it.
  value           String
  /// string | number | date | boolean - what the source cell actually was.
  valueType       String @default("string")
  /// Short operator-facing reason this column had no canonical destination,
  /// copied from the mapping decision. Explains the row without a lookup.
  semanticClass   String
  /// NORMAL | RESTRICTED. RESTRICTED is excluded from clinic bulk export.
  sensitivity     String @default("NORMAL")

  importedAt DateTime @default(now())

  /// Idempotency: re-running the same run over the same row and column can
  /// never duplicate evidence.
  ///
  /// Both composite names are PINNED with `map:`. Prisma's generated names here
  /// exceed PostgreSQL's 63-character identifier limit and would be silently
  /// truncated, leaving schema.prisma and the migration SQL disagreeing about
  /// what the index is called. Same reason MigrationReferenceMap pins its own.
  @@unique([migrationRunId, patientId, sourceColumn, sourceRowNumber], map: "MigrationPreservedSourceValue_run_patient_column_row_key")
  @@index([patientId, sourceColumn])
  @@index([organizationId, sourceSystem, sourceColumn], map: "MigrationPreservedSourceValue_org_system_column_idx")
  @@index([clinicId])
  @@index([migrationRunId])
}

/// F3-DATA-MIG-003 / G-E4 - Encrypted national/travel identity documents.
///
/// A SEPARATE CHILD MODEL, deliberately not scalars on Patient: GET
/// /api/patients/:id uses `include:` with no top-level `select:` and responds
/// with a whole-record spread (routes/patients.ts:167-191, :273), so ANY new
/// Patient scalar auto-leaks to every authorized clinic client with zero code
/// change. A relation is returned only when explicitly included - and it never
/// is. This makes the boundary safe by construction rather than safe by
/// remembering to refactor the hottest patient route.
///
/// docType: TCKN | PASSPORT | FOREIGN_ID  (stable backend string contract)
///
/// valueEncrypted: AES-256-GCM under DEDICATED patient-identity key material -
///   NEVER the general ENCRYPTION_KEY and never its lifecycle. A T.C. Kimlik No
///   is immutable, lifelong, government-issued regulated PII: it cannot be
///   reissued if the key protecting it leaks, unlike every current
///   ENCRYPTION_KEY consumer (rotatable machine secrets). See
///   server/src/utils/patientIdentityCrypto.ts - fail-closed, per call.
///
/// lookupHash: HMAC-SHA256(dedicated lookup secret,
///   organizationId + ':' + docType + ':' + normalizedValue) - TENANT-BOUND by
///   construction. The same normalized identity value in two different
///   organizations MUST NOT produce the same persisted token, or the column
///   becomes a cross-tenant correlator readable by anyone with DB access.
///   NEVER an unkeyed hash: the valid TC space is ~9e8 and exhaustively
///   invertible in well under a second - an unkeyed hash is plaintext with
///   extra steps.
///
/// cryptoVersion: key generation. No rotation mechanism exists in the product
///   today; this column exists so adding one later is an additive backfill
///   rather than a destructive rewrite, and so old-generation ciphertext stays
///   readable while a rotation is in progress.
///
/// isVerified: only ever true for a value that passed shape + checksum
///   validation. Legacy-invalid, ambiguous and source-duplicate values are
///   QUARANTINED - no row is written at all - and recorded only as a
///   classification on MigrationRowOutcome. A malformed legacy value must never
///   be converted into a verified identity.
///
/// NO cross-patient unique constraint at launch: source data carries 30
/// duplicate values across 60 rows whose nature (genuine duplicate /
/// guardian-on-minor / data-entry error) is not determinable from the workbook.
/// Collisions are surfaced as a soft warning for manual review and are NEVER
/// auto-merged. @@unique([patientId, docType]) IS a genuine invariant and all
/// legacy data satisfies it.
model PatientIdentityDocument {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  clinicId       String
  clinic         Clinic       @relation("PatientIdentityDocumentClinic", fields: [clinicId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  docType        String
  valueEncrypted String
  lookupHash     String
  cryptoVersion  Int     @default(1)
  isVerified     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, docType])
  @@index([organizationId, docType, lookupHash])
  @@index([clinicId])
}

/// F5-2 — Transactional outbox event (ADR-006, repository phase F6 / ClickUp EPIC F5).
///
/// THE INVARIANT THIS TABLE EXISTS FOR: a business state change and the record
/// of the side effect it obliges are written in ONE transaction. If the
/// business transaction rolls back, the obligation vanishes with it; if it
/// commits, the obligation is durable even if the process dies in the next
/// instruction. F5-1P experiment E11/E11b measured exactly this, and E11c
/// measured why a Redis-backed queue structurally cannot provide it.
///
/// SCALAR-ONLY, no Prisma relations — deliberately, following AuditLog and
/// MessagingInboundEvent. An operational ledger must not add back-relation
/// fields to Organization/Clinic, and must stay writable in the same
/// transaction as any business model without ordering constraints.
///
/// KVKK: `payload` carries IDENTIFIERS ONLY. The per-version field allowlist in
/// outbox/outboxEventRegistry.ts is enforced at publish AND at dispatch, so a
/// poison event cannot park PHI in an operational table. `lastErrorCode` and
/// `deadLetterCode` are stable classification codes, never provider bodies.
model OutboxEvent {
  id String @id @default(uuid())

  /// Tenant ownership. NOT NULL: every event type registered today is
  /// tenant-owned. A future system-owned event type would need this decision
  /// re-opened in a reviewable diff, not a nullable column now.
  organizationId String
  /// Null for organization-level events that legitimately have no one clinic.
  clinicId       String?

  /// Contract identity. (eventType, eventVersion) MUST resolve in the registry;
  /// an unregistered pair is refused at publish and dead-lettered at dispatch.
  eventType    String
  eventVersion Int

  /// What the event is about (e.g. 'AppointmentRequest' + its id).
  aggregateType String
  aggregateId   String

  /// Identifiers only — see the model docstring.
  payload Json

  /// Business idempotency key handed to the consumer. Stable across retries AND
  /// across replays, so a replay cannot duplicate an already-applied effect.
  idempotencyKey String

  /// Producer-side duplicate suppression. UNIQUE where present; NULL for event
  /// types that are legitimately allowed to repeat (Postgres treats NULLs as
  /// distinct, so this stays a partial-unique in practice).
  dedupeKey String? @unique

  /// Request/correlation id when the producer already has one. `causationId`
  /// points at the event that caused this one (a replay records its parent).
  correlationId String?
  causationId   String?

  /// pending | claimed | processed | dead
  status String @default("pending")

  /// When the business fact happened (producer clock, inside the transaction).
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Not claimable before this. Backoff and delayed dispatch both move it.
  availableAt DateTime

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  /// Stable OutboxErrorCode only.
  lastErrorCode String?

  /// Lease. A dispatcher that stops renewing lets `leaseExpiresAt` pass and the
  /// row becomes reclaimable — crash recovery without a distributed lock.
  claimedAt      DateTime?
  claimedBy      String?
  leaseExpiresAt DateTime?

  processedAt    DateTime?
  deadLetteredAt DateTime?
  /// Why the event is terminal. Stable code, never free text.
  deadLetterCode String?

  /// Replay audit. The full audit row goes to AuditLog; these make the state
  /// visible without a join.
  replayCount    Int       @default(0)
  lastReplayedAt DateTime?
  lastReplayedBy String?

  /// The dispatcher's claim query. Covers the hot path: pending rows whose
  /// availableAt has passed, oldest first.
  @@index([status, availableAt, occurredAt])
  /// Stale-lease reclaim sweep.
  @@index([status, leaseExpiresAt])
  /// Per-tenant backlog metrics and operator DLQ inspection.
  @@index([organizationId, status, occurredAt])
  @@index([clinicId, status, occurredAt])
  /// Per-contract backlog/failure slicing.
  @@index([eventType, eventVersion, status])
  @@index([idempotencyKey])
}

/// F5-2 — consumer-side business idempotency ledger.
///
/// The outbox guarantees AT-LEAST-ONCE delivery: a dispatcher that crashes
/// between performing a side effect and finalizing the row WILL retry. That is
/// not a defect to design away — it is the cost of durability, and the only
/// honest answer is a consumer-side record of what has already been applied.
///
/// The protocol (outbox/outboxIdempotency.ts):
///   1. commit an `in_progress` marker with a lease BEFORE the side effect;
///   2. perform the side effect;
///   3. mark `completed`.
/// A retry that finds `completed` suppresses the duplicate. A retry that finds
/// a LIVE `in_progress` defers (another dispatcher owns it). A retry that finds
/// an EXPIRED `in_progress` is genuinely ambiguous — the side effect may or may
/// not have happened — and is recorded `ambiguous` and dead-lettered rather
/// than silently re-sent to a patient or silently dropped.
model OutboxConsumerExecution {
  id String @id @default(uuid())

  /// Registered consumer key that owns this execution.
  consumerKey    String
  /// The event's business idempotency key.
  idempotencyKey String

  organizationId String
  clinicId       String?

  /// in_progress | completed | ambiguous
  status String

  /// Dispatcher instance holding the in-progress marker.
  executedBy     String?
  leaseExpiresAt DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// Stable outcome code. Never PII, never a provider body.
  outcomeCode String?
  updatedAt   DateTime  @updatedAt

  /// THE constraint that makes duplicate suppression a database property rather
  /// than an application convention.
  @@unique([consumerKey, idempotencyKey])
  @@index([organizationId, status])
  @@index([status, leaseExpiresAt])
}
