DATABASE_URL="postgresql://crm_user:change-me@localhost:5432/noramedi_crm?schema=public"
# Postgres bağlantı havuzu (pg Pool). DB_POOL_MAX: süreç başına en fazla
# bağlantı (varsayılan 10; Postgres max_connections sınırını replika sayısıyla
# birlikte düşünün). CONNECT_TIMEOUT: havuzdan bağlantı bekleme üst sınırı.
# DB_POOL_MAX=10
# DB_POOL_CONNECT_TIMEOUT_MS=10000
# DB_POOL_IDLE_TIMEOUT_MS=30000
JWT_SECRET="change-me-to-at-least-32-random-characters"
# Platform admin panel JWT secret (separate from regular JWT_SECRET)
PLATFORM_JWT_SECRET="change-me-to-a-different-32-random-character-secret"
WHATSAPP_WEBHOOK_SECRET="change-me-to-a-random-webhook-secret"
PORT=5000
# Bind address. Set to 127.0.0.1 in production so the port is not reachable
# directly from the network (Nginx proxies through loopback). Default: 0.0.0.0.
# Production: LISTEN_HOST=127.0.0.1
LISTEN_HOST=0.0.0.0
CORS_ORIGINS="http://localhost:5173"
# Development:
# CORS_ORIGINS="http://localhost:5173"
# Production:
CORS_ORIGINS="https://app.noramedi.com,https://noramedi.com"
FRONTEND_URL=https://app.noramedi.com
JSON_BODY_LIMIT="1mb"
# Session cookies.
# Production: frontend https://app.noramedi.com, API https://api.noramedi.com
# Cross-subdomain: set SESSION_COOKIE_DOMAIN=.noramedi.com and SESSION_COOKIE_SAMESITE=none (requires HTTPS).
# Same-origin (API proxied under /api): leave SESSION_COOKIE_DOMAIN empty, SameSite=lax.
CSRF_SECRET="change-me-to-a-different-32-random-character-secret"
# Imaging bridge pairing code HMAC pepper — required (>=32 chars) in production.
# Without it, pairing codes would be reversible sha256(code) hashes only.
IMAGING_BRIDGE_PAIRING_PEPPER="change-me-to-a-different-32-random-character-secret"
# Self-service Windows imaging bridge onboarding UI — keep false until the full
# release gate (installer, PR 1-7) passes. Backend endpoints exist regardless.
BRIDGE_SELF_SERVICE_ENABLED=false
# Windows Bridge web onboarding (PR 5/7) — GET /api/imaging/bridge-onboarding/config.
# Fail-closed: leave false in production until a signed installer is published
# and this whole 7-PR feature is ready for general availability.
IMAGING_BRIDGE_ONBOARDING_ENABLED=false
# Only used when IMAGING_BRIDGE_ONBOARDING_ENABLED=true. Must be HTTPS in
# production (a localhost http:// URL is only accepted outside production).
IMAGING_BRIDGE_INSTALLER_DOWNLOAD_URL=
# x.y.z (matches the installer's ProductVersion, e.g. from installer.md)
IMAGING_BRIDGE_INSTALLER_VERSION=
# 64-char lowercase hex SHA-256 of NoraMediBridgeSetup.exe
IMAGING_BRIDGE_INSTALLER_SHA256=
# Set true only once the installer is Authenticode-signed — never claim an
# unsigned installer is signed (see windows-bridge/docs/installer.md).
IMAGING_BRIDGE_INSTALLER_SIGNED=false
# Windows Bridge auto-update (PR 6/7, GET /api/public/imaging/bridge/update).
# disabled (default) | notify | automatic. Unset/unrecognized -> disabled —
# fail closed. See windows-bridge/docs/update-server.md.
IMAGING_BRIDGE_UPDATE_MODE=disabled
# x.y.z / x.y.z.w — must match the MSI/Bundle ProductVersion of the offered release.
IMAGING_BRIDGE_UPDATE_VERSION=
# HTTPS required in production (localhost http allowed only outside production).
IMAGING_BRIDGE_UPDATE_DOWNLOAD_URL=
# 64-char lowercase hex SHA-256 of NoraMediBridgeSetup.exe for this release.
IMAGING_BRIDGE_UPDATE_SHA256=
# Set true only once the installer is Authenticode-signed by the pinned
# publisher below. In production, an unsigned release is never offered.
IMAGING_BRIDGE_UPDATE_SIGNED=false
# 40-char hex Authenticode certificate thumbprint the bridge pins as the
# only trusted publisher for this release. Required when *_SIGNED=true.
IMAGING_BRIDGE_UPDATE_PUBLISHER_THUMBPRINT=
# Optional: oldest installed source version this release supports upgrading
# from (x.y.z). Leave blank to allow any older version.
IMAGING_BRIDGE_UPDATE_MIN_SOURCE_VERSION=
# Optional short release notes surfaced in the Manager update UI.
IMAGING_BRIDGE_UPDATE_NOTES=
# Windows Bridge production hardening (PR 7/7) — staged rollout + one-step rollback.
# Required whenever IMAGING_BRIDGE_UPDATE_MODE != disabled: opaque ID used only as
# deterministic-cohort hash input (safe charset: letters, digits, dot, dash,
# underscore, max 128 chars). Changing this reshuffles rollout cohorts for the
# next release.
IMAGING_BRIDGE_UPDATE_RELEASE_ID=
# Integer 0-100. Percentage of paired bridges (per channel) offered this release,
# assigned deterministically per bridge+release (never re-rolled, never random).
# 0 pauses rollout without touching IMAGING_BRIDGE_UPDATE_MODE (kill switch);
# defaults to 100 (full rollout) when unset.
IMAGING_BRIDGE_UPDATE_ROLLOUT_PERCENT=100
# stable | pilot. Exact match against the paired bridge's ImagingBridgeAgent.updateChannel
# (defaults to 'stable' per bridge). Defaults to 'stable' when unset. An
# unrecognized value invalidates the whole release descriptor (fail closed).
IMAGING_BRIDGE_UPDATE_CHANNEL=stable
# true bypasses IMAGING_BRIDGE_UPDATE_ROLLOUT_PERCENT (never bypasses channel,
# mode, or minimum-source-version gating). Reserve for security/critical fixes.
IMAGING_BRIDGE_UPDATE_FORCED=false
# One-step rollback target (PR 7/7): the previously-trusted release the bridge
# caches locally BEFORE installing IMAGING_BRIDGE_UPDATE_VERSION, so it can
# revert without contacting the server if the new version fails its post-install
# health check. All four fields are optional but must be set together — a
# partial/malformed set is rejected as "no rollback available" (fail closed),
# never a partially-trusted rollback target. Leave unset until this release's
# immediate predecessor is confirmed as the correct rollback target.
IMAGING_BRIDGE_ROLLBACK_VERSION=
IMAGING_BRIDGE_ROLLBACK_DOWNLOAD_URL=
IMAGING_BRIDGE_ROLLBACK_SHA256=
IMAGING_BRIDGE_ROLLBACK_PUBLISHER_THUMBPRINT=
SESSION_COOKIE_SAMESITE="lax"
SESSION_COOKIE_SECURE=false
# Production:
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=
# Bearer token fallback is OFF by default (the frontend is fully cookie-based
# and Bearer requests bypass CSRF). Enable only temporarily during a migration.
# AUTH_BEARER_FALLBACK_ENABLED=false
# CLINIC_BEARER_FALLBACK_ENABLED=false
# PLATFORM_BEARER_FALLBACK_ENABLED=false
# Hop count (or true/false/subnet list) for Express trust proxy. Default 1 —
# correct when the app sits behind a single Nginx; IP rate limits depend on it.
# TRUST_PROXY=1
EVOLUTION_API_BASE_URL="http://localhost:8080"
EVOLUTION_API_KEY="change-me"
EVOLUTION_INSTANCE_NAME="noramedi"

# Panel-first WhatsApp mode.
# Set to "false" in production once all connections have been imported via the panel
# (Organization → WhatsApp → Panel Yönetimine Aktar) and verified.
# Default: false in production. Keep false for tenant-safe webhook routing.
# See migration guide in server/src/utils/legacyWhatsApp.ts.
ENABLE_LEGACY_WHATSAPP_ENV_FALLBACK=false

# AI / Gemini (optional — for WhatsApp bot auto-reply)
GEMINI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.0-flash"

# Meta Cloud API (Backend)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# AES-256-GCM encryption key for WhatsApp connection tokens (64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# Set MAIL_ENABLED=true and provide SMTP credentials to enable email sending.
# Works with any SMTP provider: Brevo, Mailgun, Postmark, Amazon SES, own server.
# When MAIL_ENABLED=false (default), forgot-password still returns generic success
# but no email is sent — safe for development.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NoraMedi <no-reply@noramedi.com>"
SMTP_REPLY_TO=
# Base URL for password reset links sent in emails (no trailing slash)
APP_BASE_URL=https://app.noramedi.com

# ── Database backup wrapper (F4-FCR-001) ─────────────────────────────────────
# The DB backup itself is produced by /usr/local/sbin/noramedi-db-backup.sh,
# an EXTERNAL host script that is NOT in this repository and has never been
# reviewed by any task in this program. These two settings only affect the
# application's wrapper around it.
#
# How old (hours) the newest .dump may be before the platform admin recovery
# status reports it stale. Default 30, matching
# NORAMEDI_OPSCHECK_BACKUP_MAX_AGE_HOURS. No backup at all is always stale.
# DB_BACKUP_MAX_AGE_HOURS=30
#
# Comma-separated allowlist of environment variable names passed to that
# external script. LEAVE UNSET to keep the pre-F4-FCR-001 behaviour, which
# hands the script the ENTIRE process environment — including ENCRYPTION_KEY,
# JWT_SECRET and PLATFORM_JWT_SECRET. Narrowing it is safer but can break
# backups, because nobody has read what the script actually needs; set this
# only after reading the script (see
# docs/program/runbooks/F4_RECOVERY_OPERATIONS.md §2). PATH, HOME, LANG and
# LC_ALL are always included when the allowlist is set.
# BACKUP_SCRIPT_ENV_ALLOWLIST=DATABASE_URL,PGHOST,PGPORT,PGUSER,PGPASSWORD,PGDATABASE

# ── File backup / off-host replication (FILE-BACKUP-COVERAGE-001) ────────────
# Backs up patient attachments, lab-order attachments, and imaging images to a
# SEPARATE destination from primary storage (see fileStorage.ts's own S3_*
# vars, which this deliberately does not reuse). Off by default (fail-closed).
# See docs/program/evidence/FILE_BACKUP_COVERAGE_001.md for the full rollout
# procedure — do not enable in production without following it.
FILE_BACKUP_ENABLED=false
# Cron schedule for the automatic sweep. Default: daily at 03:00 local time.
# FILE_BACKUP_CRON="0 3 * * *"
# FILE_BACKUP_BATCH_SIZE=100
# FILE_BACKUP_RESTORE_REHEARSAL_SAMPLE_SIZE=5
#
# How old (hours) the last completed file backup may be before the platform
# admin recovery status reports it stale. Default 30, deliberately matching
# NORAMEDI_OPSCHECK_FILEBACKUP_MAX_AGE_HOURS so the in-app view and the host
# monitor never disagree about what "stale" means. Never having run at all is
# always stale, regardless of this value.
# FILE_BACKUP_MAX_AGE_HOURS=30
#
# Destination — configure EXACTLY ONE of the two blocks below. Local dir is
# for development/testing only; it does NOT satisfy an off-host requirement
# by itself (see the evidence doc's coverage matrix).
# FILE_BACKUP_LOCAL_DIR=/path/to/a/second/disk/or/mounted/share
#
# S3-compatible destination (recommended for production — AWS S3, MinIO,
# Cloudflare R2, or a Turkey-hosted S3-compatible provider):
# FILE_BACKUP_S3_BUCKET=
# FILE_BACKUP_S3_REGION="auto"
# FILE_BACKUP_S3_ENDPOINT=
# FILE_BACKUP_S3_ACCESS_KEY_ID=
# FILE_BACKUP_S3_SECRET_ACCESS_KEY=
# FILE_BACKUP_S3_FORCE_PATH_STYLE=false
#
# Production S3-mode safety (fail-closed — see
# docs/program/evidence/FILE_BACKUP_COVERAGE_001.md §14). With NODE_ENV=production,
# S3-mode backup REFUSES to start unless FILE_BACKUP_S3_SSE is set, and refuses
# an FILE_BACKUP_S3_ENDPOINT that isn't https:// unless the insecure override
# below is explicitly set. Neither check applies outside production (dev/test).
# FILE_BACKUP_S3_SSE="AES256"              # or "aws:kms"
# FILE_BACKUP_S3_SSE_KMS_KEY_ID=           # only used when FILE_BACKUP_S3_SSE=aws:kms
# FILE_BACKUP_S3_ALLOW_INSECURE_ENDPOINT=false  # explicit opt-out only, e.g. private-network MinIO with no TLS termination
#
# Bucket-level controls this application cannot verify or enforce from code
# (versioning, object lock, lifecycle/retention, IAM policy on the credentials
# above) are documented as operator requirements in the evidence doc §14 —
# they are NOT configured by setting any environment variable here.

# ── Imaging-primary VPS2 storage (F4-IMAGING-001, ClickUp 869em3zqg) ─────────
# Routes ONLY new imaging-image writes/reads to a second, independent
# S3-compatible destination — a SEPARATE concern from both fileStorage.ts's
# own S3_* (primary storage for every OTHER content class: patient/lab
# attachments, export archives) and FILE_BACKUP_S3_* above (an off-host COPY
# of what's already in primary storage). See services/imagingRemoteStorage.ts
# for the full contract.
#
# Off by default (fail-closed / rollback switch): leave IMAGING_STORAGE_BACKEND
# unset and imaging reads/writes behave exactly as before this feature existed
# (fileStorage.ts's ordinary local/S3 path). Setting it to "vps2" activates
# VPS2-first writes/reads for NEW imaging objects only — existing imaging
# objects keep resolving from wherever they already are (a VPS2 read that is
# confirmed absent, i.e. a clean 404/NoSuchKey, falls back to the existing
# local/S3 path; a VPS2 backend that cannot be reached at all is surfaced as a
# failure, never silently substituted with unrelated legacy content).
#
# ROLLBACK IS ONE-WAY AFTER THE FIRST VPS2 WRITE (R3 correction — read this
# before enabling). Turning the flag back OFF is byte-identical to never having
# enabled it ONLY while no object has been written to VPS2 yet. The VPS2 read
# path lives entirely inside the same flag guard, so once an imaging object has
# been written only to VPS2, unsetting the flag makes that object unreadable
# (the request 404s) — there is no legacy->VPS2 read direction, and no DB column
# records which backend holds a given object. Rolling back after any VPS2 write
# therefore requires copying those objects back out-of-band, not just a config
# change. Treat "off -> on" as reversible and "on -> off after traffic" as a
# migration.
# IMAGING_STORAGE_BACKEND=vps2
#
# IMAGING_S3_BUCKET=              # required when the backend above is "vps2"
# IMAGING_S3_REGION="auto"
# IMAGING_S3_ENDPOINT=            # REQUIRED when the backend above is "vps2".
#   Absolute URL including scheme, e.g. "https://imaging.vps2.example:9000".
#   Unlike FILE_BACKUP_S3_ENDPOINT (where unset legitimately means "real AWS
#   S3"), leaving this unset is a startup FAILURE here: the AWS SDK would
#   otherwise resolve its own default public AWS endpoint and imaging bytes
#   (KVKK special-category health data) would silently leave Türkiye while the
#   configuration still claimed "vps2". Fail-closed by design.
# IMAGING_S3_ACCESS_KEY_ID=
# IMAGING_S3_SECRET_ACCESS_KEY=
# IMAGING_S3_FORCE_PATH_STYLE=true   # required for most self-hosted S3-compatible services (MinIO etc.)
#
# Production S3-mode safety (fail-closed, near-identical shape to
# FILE_BACKUP_S3_* above). With NODE_ENV=production, VPS2-mode imaging storage
# REFUSES TO SERVE imaging requests unless IMAGING_S3_SSE is set, and refuses an
# IMAGING_S3_ENDPOINT that isn't https:// unless the insecure override below is
# explicitly set. (The endpoint's *presence* and URL validity are required in
# EVERY environment, not just production — see above.) The SSE and https rules
# do not apply outside production (dev/test) — a disposable local MinIO container
#
# TIMING CAVEAT (accuracy correction, R3): these checks are enforced LAZILY, on
# first S3 client construction inside a request (validateImagingS3Config() is
# called only from getImagingS3()), NOT at process boot. There is currently no
# startup-time call, so a misconfigured IMAGING_S3_* passes deploy and health
# checks and first surfaces as a failed imaging request. Do not read "refuses"
# as "the process will not start". Adding a boot-time validation call is
# tracked as a pre-activation item, not done in this PR.
# (this feature's own synthetic-test target, see
# src/tests/imagingRemoteStorage.test.ts) keeps working without TLS or KMS.
# IMAGING_S3_SSE="AES256"              # or "aws:kms"
# IMAGING_S3_SSE_KMS_KEY_ID=           # only used when IMAGING_S3_SSE=aws:kms
# IMAGING_S3_ALLOW_INSECURE_ENDPOINT=false  # explicit opt-out only, e.g. private-network endpoint with no TLS termination
#
# NOT satisfied by setting these variables (see
# docs/program/NORAMEDI_MASTER_TRACKER.md's F4-IMAGING-001 entry): an actual
# S3-compatible service running on VPS2, network reachability from the app
# host to VPS2 (no such firewall exposure is authorized yet — VPS2's
# 2026-08-19 firewall baseline is SSH-only), volume-level encryption at rest
# on VPS2 (single unencrypted ext4 partition today), and real patient imaging
# data (synthetic test data only until IHS §6 E1-E5 residency evidence lands).

# ── Restore rehearsal / recovery status (F4-FCR-001) ─────────────────────────
# A backup nobody has ever restored is a hope, not a recovery capability. The
# restore rehearsal periodically pulls real backed-up objects back out of the
# backup destination, verifies them, and records the outcome. Off by default
# (fail-closed): it reads from the backup destination and writes only to a
# temporary working area, but it is still real I/O against production storage,
# so it is opted into deliberately rather than switched on by upgrade.
RESTORE_REHEARSAL_ENABLED=false
# Cron schedule for the rehearsal. Default: weekly, Sunday 04:30 local time —
# offset well clear of FILE_BACKUP_CRON (03:00) so a rehearsal never competes
# with the sweep it is meant to be verifying.
# RESTORE_REHEARSAL_CRON="30 4 * * 0"
#
# Which verified backup entries the rehearsal samples: "newest" | "oldest" |
# "mixed" (default). Prefer the default. Sampling only the newest entries —
# the pre-F4-FCR-001 behaviour — structurally can never detect bit rot or
# out-of-band tampering in OLD destination objects, because a once-verified
# entry is never re-verified. "mixed" splits the sample between the newest and
# the oldest entries so aging objects are exercised too.
# RESTORE_REHEARSAL_STRATEGY=mixed
#
# When true, the rehearsal refuses to run unless it can use synthetic (seeded,
# non-patient) objects, rather than sampling real patient attachments. Leave
# false only where sampling real objects is acceptable; set true to guarantee
# no patient file is ever read by the rehearsal path. Fail-closed in the sense
# that "no synthetic fixtures available" becomes a hard stop, not a silent
# fallback to real data.
# RESTORE_REHEARSAL_REQUIRE_SYNTHETIC=false
# Comma-separated clinic IDs whose data is synthetic and safe to rehearse
# against. Required when RESTORE_REHEARSAL_REQUIRE_SYNTHETIC=true; empty means
# no clinic is designated synthetic.
# RESTORE_REHEARSAL_SYNTHETIC_CLINIC_IDS=
#
# How old (hours) the last passed rehearsal may be before the application
# considers the recovery capability unproven. Default 168 = 7 days, i.e. one
# weekly rehearsal. The ops monitor's own threshold
# (NORAMEDI_OPSCHECK_DRILL_MAX_AGE_HOURS, default 192 = 8 days) is
# deliberately the LOOSER of the two, so the application flags a late
# rehearsal before the external dead-man's-switch pages anyone.
# RECOVERY_DRILL_MAX_AGE_HOURS=168
#
# Where the application writes the recovery status file that
# scripts/noramedi-opscheck.sh reads for its `filebackup` and `drill` checks.
# That monitor deliberately does NOT query PostgreSQL (it must keep working
# while the app is down, and must not carry DB credentials), so this file is
# the entire interface between them. MUST match the monitor's
# NORAMEDI_OPSCHECK_RECOVERY_STATUS_FILE; if the two disagree, the monitor
# reads a file nobody writes and alerts permanently. The directory must exist
# and be writable by the app process; the file contains status, timestamps and
# counters only — never patient data, never a secret.
# NORAMEDI_RECOVERY_STATUS_FILE=/var/lib/noramedi/recovery-status.json
#
# How often the recovery status file is refreshed. Default every 10 minutes.
# This cadence must stay well BELOW
# NORAMEDI_OPSCHECK_RECOVERY_STATUS_MAX_AGE_HOURS, because the host monitor
# uses the file's own `generatedAt` as a writer-liveness signal: if the worker
# dies, the file stops being refreshed and both the filebackup and drill
# checks fail closed rather than trusting last-known-good contents.
# This same tick also sweeps backup/drill rows abandoned by a crashed process.
# RECOVERY_STATUS_CRON="*/10 * * * *"

# ── PITR / WAL archive status (F4-FCR-002) ───────────────────────────────
# Where the application READS the PITR status document from.
#
# DIRECTION IS REVERSED HERE, and it matters. Every other status file in this
# program is written by the app and read by the shell. This one is written by
# a root-owned shell script (scripts/noramedi-pgbackrest-status.sh, on its own
# systemd timer) and only READ by the app. Consequently the application never
# invokes pgbackrest, never shells out, never needs the PostgreSQL superuser,
# and never touches the repository cipher passphrase — which keeps a subsystem
# holding a physical copy of every patient table out of reach of any HTTP
# route.
#
# MUST match the writer's NORAMEDI_PITR_STATUS_FILE and the monitor's
# NORAMEDI_OPSCHECK_PITR_STATUS_FILE. All three default to the same path, so
# leave this unset unless you have a reason not to.
#
# A missing file is the NORMAL state today: PITR is not activated, and
# enabling it needs an approved freeze exception plus a PostgreSQL restart.
# The Platform Admin page renders that as "not configured", not as an error.
# Everything else — unreadable, malformed, wrong schema version, stale, or
# future-dated — fails closed and is shown as a fault.
# NORAMEDI_PITR_STATUS_FILE=/var/lib/noramedi/pitr-status.json

# F3-OBS-001 / F3-C2-ERR-001: optional Sentry-compatible external error
# tracking (utils/errorTracking.ts). `@sentry/node` IS a pinned dependency as
# of F3-C2-ERR-001, so setting the DSN below is all that activates delivery.
#
# Unset (default, and every environment today): captureFatalError() is a pure
# no-op and `@sentry/node` is never even imported into the process. Nothing is
# sent anywhere; installing the dependency costs disk, not runtime surface.
#
# Set: one *synthetic, fixed-shape* event per 5xx is sent — a hardcoded
# message plus errType ('Error'|'UnknownError'), role, requestId and a safe
# route template. Never err.message/stack/cause/name, never request bodies,
# headers, cookies, query values, tokens, patient data, hostname, or the
# installed-module inventory. The SDK is initialized deny-by-default (all
# integrations off, no OpenTelemetry setup, no ESM loader hooks) and every
# outbound event is rebuilt from an allow-list — see the module docstring.
#
# ACTIVATION IS NOT PURELY TECHNICAL: an external error-tracking provider is a
# KVKK data processor. Do not set this in production before the subprocessor
# register (docs/compliance/62-kvkk-subprocessor-register.md §7) records the
# chosen provider, its data region, and its DPA status. Follow the runbook in
# docs/program/evidence/F3-OBS-001_PRODUCTION_OBSERVABILITY_MINIMUM.md §15.
#
# This value is a credential-equivalent (it authorizes ingest into your
# project). Keep it in the production .env only — never commit it, never echo
# it in deploy output.
# SENTRY_DSN=
#
# Release identifier attached to error-tracking events when SENTRY_DSN is set.
# scripts/noramedi-deploy.sh derives this from the deployed git SHA and exports
# it before `pm2 startOrReload --update-env`, so you normally do NOT need to
# set it here; a value set in the process environment wins over this file
# (dotenv does not override already-set variables). Set it only to pin a
# release tag that is not the deployed commit.
# RELEASE_SHA=

# ── Patient national identity (T.C. Kimlik No) — F3-DATA-MIG-TODAY ───────────
# DEDICATED key material for the encrypted PatientIdentityDocument model. These
# are NOT optional extras and NOT interchangeable with any other secret below.
#
# WHY A SEPARATE KEY AT ALL. Reusing the general ENCRYPTION_KEY here was an
# explicitly WITHDRAWN program decision. Every current ENCRYPTION_KEY consumer
# protects a ROTATABLE MACHINE SECRET (WhatsApp tokens, webhook secrets): if
# that key leaks, you revoke and reissue and the exposure ends. A T.C. Kimlik No
# is immutable, lifelong and government-issued — it cannot be reissued. A leak
# is permanent, so it does not share a key or a lifecycle with anything
# rotatable.
#
# THE ISOLATION RULE IS ENFORCED IN CODE, not just written here. Each of the two
# values below must NOT be the same value as ENCRYPTION_KEY / JWT_SECRET /
# PLATFORM_JWT_SECRET / CSRF_SECRET / CLINIC_BULK_EXPORT_IP_HASH_SECRET, and
# must not equal each other. A collision makes
# assertPatientIdentityCryptoConfigured() throw IDENTITY_CRYPTO_NOT_CONFIGURED
# on every identity read and write.
#
# FAIL CLOSED, EVERY ENVIRONMENT. There is no development fallback key and no
# "warn and continue" path. Unset or malformed means identity documents cannot
# be written or read at all — never that they are written under a default key.
#
# AES-256-GCM key, generation 1 — exactly 64 hex chars (32 bytes).
# Generate: openssl rand -hex 32
PATIENT_IDENTITY_ENCRYPTION_KEY=
#
# Future key generations (rotation-ready, additive). Stored ciphertext carries a
# `pid:v<N>:` prefix, so old-generation rows stay readable while a rotation is
# in progress — never retire a generation whose ciphertext has not been
# re-encrypted, or those rows become permanently unreadable.
# Generate: openssl rand -hex 32
# PATIENT_IDENTITY_ENCRYPTION_KEY_V2=
#
# Dedicated HMAC pepper for the TENANT-BOUND identity lookup token
# HMAC-SHA256(pepper, organizationId + ':' + docType + ':' + normalizedValue).
# Minimum 32 characters. It never enters the database — that is what makes the
# token non-invertible. An UNKEYED hash would be plaintext with extra steps: the
# valid T.C. Kimlik No space is ~9e8 and is exhaustively invertible in well
# under a second on commodity hardware.
