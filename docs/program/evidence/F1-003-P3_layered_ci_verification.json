  "p3r1RootCausedCiDefect": {
    "discoveredVia": "actual GitHub Actions run 30536185063 on the original PR #268 head SHA e99dd096d2d6d1222c9f7c7f59c0735ab4380979 - NOT reproduced by local validation",
    "failingJob": "non-disposable-backend-tests",
    "errorMessage": "SyntaxError: The requested module '@prisma/client' does not provide an export named 'PrismaClient'",
    "rootCause": "the job ran `npm ci` then directly invoked `npm run server:test:non-disposable` without ever running `npx prisma generate`; server/package.json has no postinstall hook that does this; the only two places generate happens are the separate server-typecheck job (different runner/checkout, does not share state) and the F1-003-P2 orchestrator's runMigrations() (used by Layers 3/4 and the new backend-compat job, which is exactly why those succeeded on the same run)",
    "whyNotCaughtLocally": "this task's local working directory had already generated the Prisma Client via earlier, unrelated commands in the same persistent environment; a from-scratch checkout reproduces the failure every time",
    "fix": "added an explicit 'npx prisma generate' step to non-disposable-backend-tests in ci-layers.yml, before the test-aggregate step",
    "filesChanged": [".github/workflows/ci-layers.yml"],
    "testOrApplicationCodeChanged": false
  },
  "p3r1ArtifactGenerationFix": {
    "problem": "npm run test:runtime:postgres | tee postgres-run-summary.json captured combined human-readable stdout, not valid standalone JSON",
    "optionChosen": "Option 1 (preferred) - dedicated machine-readable summary file produced by the runtime itself",
    "implementation": {
      "newModule": "scripts/test-runtime/lib/summaryFile.ts",
      "newFunction": "maybeWriteSummaryFile(args, data)",
      "newCliFlag": "--summary-file=<path>",
      "wiredInto": ["postgres/postgres-compat/storage summary output", "verify-parallel result output", "cleanup-stale report output"]
    },
    "secondDefectFoundAndFixedDuringThisWork": {
      "description": "an initial implementation let writeFileSync throw on a bad path, propagating out of main() to the top-level catch handler and overriding the real, already-determined test-outcome exit code with a generic fatal-error exit 1",
      "discoveredVia": "this task's own local verification (an accidental invalid path during testing), before reaching CI",
      "fix": "maybeWriteSummaryFile now catches and logs any write failure to stderr and never throws - an artifact-handling failure must never conceal the real exit code",
      "unitTestsAdded": 4
    },
    "ciWiring": {
      "jsonValidationStep": "node -e JSON.parse(...) on the summary file, failure-only",
      "secretPatternScanStep": "grep -EiI for postgresql://, AKIA[0-9A-Z]{16}, PEM key headers, secretAccessKey, accessKeyId/password key-value shapes - failure-only, refuses upload if matched",
      "uploadCondition": "if: failure()",
      "retentionDays": 7
    }
  },
