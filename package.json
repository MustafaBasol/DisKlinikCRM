    "test:last-route-helpers": "tsx src/utils/__tests__/lastRoute.test.ts",
    "test:vitest": "vitest run",
    "test:runtime:unit": "tsx scripts/test-runtime/__tests__/orchestratorUnit.test.ts",
    "test:runtime:storage-gate": "tsx scripts/test-runtime/__tests__/storageGate.test.ts",
    "test:runtime:minio-readiness": "tsx scripts/test-runtime/__tests__/minioReadiness.test.ts",
    "verify:storage-run": "tsx scripts/test-runtime/verify-storage-run.ts",
    "test:runtime:postgres": "tsx scripts/test-runtime/orchestrator.ts postgres",
    "test:runtime:postgres-compat": "tsx scripts/test-runtime/orchestrator.ts postgres-compat",
    "test:runtime:storage": "tsx scripts/test-runtime/orchestrator.ts storage",
    "test:runtime:parallel": "tsx scripts/test-runtime/orchestrator.ts verify-parallel",
    "test:runtime:cleanup-stale": "tsx scripts/test-runtime/orchestrator.ts cleanup-stale",
    "typecheck:runtime": "tsc --noEmit -p scripts/test-runtime/tsconfig.json",
    "guardrail:scan": "tsx scripts/architecture-guardrail/cli.ts",
    "guardrail:test": "tsx scripts/architecture-guardrail/__tests__/index.test.ts",
    "typecheck:guardrail": "tsc --noEmit -p scripts/architecture-guardrail/tsconfig.json",
    "ci-classify": "tsx scripts/ci-classify/cli.ts",
    "test:ci-classify": "tsx scripts/ci-classify/__tests__/classify.test.ts",
    "typecheck:ci-classify": "tsc --noEmit -p scripts/ci-classify/tsconfig.json",
    "log-privacy-guard:scan": "tsx scripts/log-privacy-guard/cli.ts",
    "test:log-privacy-guard": "tsx scripts/log-privacy-guard/__tests__/index.test.ts",
    "test:shell:opscheck": "bash scripts/noramedi-opscheck.test.sh",
    "test:shell:pgbackrest": "bash scripts/noramedi-pgbackrest.test.sh",
    "test:shell:pitr-app-smoke": "bash scripts/noramedi-pitr-app-smoke.test.sh",
    "test:shell:frontend-deploy": "bash scripts/noramedi-frontend-deploy.test.sh",
    "test:shell": "npm run test:shell:opscheck && npm run test:shell:pgbackrest && npm run test:shell:pitr-app-smoke && npm run test:shell:frontend-deploy",
    "typecheck:log-privacy-guard": "tsc --noEmit -p scripts/log-privacy-guard/tsconfig.json"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "axios": "^1.18.1",
    "cornerstone-core": "2.6.1",
    "cornerstone-wado-image-loader": "4.13.2",
    "dicom-parser": "1.8.21",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.5",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.0"
  },
