    "@types/cornerstone-core": "2.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.5.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.13",
    "tsx": "4.22.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "cornerstone-wado-image-loader": {
      "uuid": "^11.1.1"
    }
  }
}
