    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test:dicom-helpers": "tsx src/components/imaging/__tests__/dicomHelpers.test.ts",
    "test:onboarding-helpers": "tsx src/components/imaging/__tests__/onboardingHelpers.test.ts",
    "test:pairing-poller": "tsx src/components/imaging/__tests__/pairingPoller.test.ts",
    "test:booking-widget-helpers": "tsx src/pages/__tests__/bookingWidgetHelpers.test.ts",
    "test:clinic-bulk-export-selection": "tsx src/components/settings/__tests__/clinicBulkExportSelectionHelpers.test.ts",
    "test:communication-consent-matrix": "tsx src/components/__tests__/communicationConsentMatrixHelpers.test.ts",
    "test:patient-detail-tabs-helpers": "tsx src/pages/__tests__/patientDetailTabsHelpers.test.ts",
    "test:patient-emergency-contacts-i18n-parity": "tsx src/pages/__tests__/patientEmergencyContactsI18nParity.test.ts",
    "test:patient-detail-nav-i18n-parity": "tsx src/pages/__tests__/patientDetailNavI18nParity.test.ts",
