# pgbackrest-status.env.example — F4-FCR-002
#
# NAME-ONLY documentation template, safe to commit because every value is
# blank or a commented default. NEVER put a real value here or in any other
# committed file.
#
# Host target: /etc/noramedi/pgbackrest-status.env  (root:root, 0600)
# Loaded by ops/systemd/noramedi-pgbackrest-status.service via
# `EnvironmentFile=-/etc/noramedi/pgbackrest-status.env`.
#
#   install -d -o root -g root -m 0750 /etc/noramedi     # install(1) does not
#                                                        # create parent dirs
#   install -o root -g root -m 0600 /dev/null /etc/noramedi/pgbackrest-status.env
#   $EDITOR /etc/noramedi/pgbackrest-status.env
#
# ⚠ NO SECRET BELONGS IN THIS FILE.
# The pgBackRest repository passphrase lives in /etc/pgbackrest/pgbackrest.conf
# (0600 postgres:postgres) and nowhere else. It must never be placed in an
# environment variable: this unit's environment is readable via
# /proc/<pid>/environ for the duration of every run, and the passphrase is the
# one secret whose loss makes every backup permanently unrecoverable.
# The status writer never reads, prints, or logs it — it only reports WHETHER
# a cipher type is configured.
#
# Every variable below is non-secret operational tuning. Defaults are shown;
# uncomment only what you actually need to change.

# pgBackRest stanza. Must match the stanza in pgbackrest.conf and the one in
# archive_command. A stanza is a CLUSTER, not a database.
# NORAMEDI_PGBACKREST_STANZA=noramedi

# Where the status document is published. MUST match the opscheck's own
# NORAMEDI_OPSCHECK_PITR_STATUS_FILE — if the two disagree, the check reads a
# file nobody writes and alerts permanently.
# NORAMEDI_PITR_STATUS_FILE=/var/lib/noramedi/pitr-status.json

# pgBackRest configuration file. Read only to determine the configured cipher
# type and whether a repo2 is declared; its passphrase line is never parsed.
# NORAMEDI_PGBACKREST_CONF=/etc/pgbackrest/pgbackrest.conf

# Repository path (used for the free-space reading only).
# NORAMEDI_PGBACKREST_REPO_PATH=/var/lib/pgbackrest

# Where the last `pgbackrest check` result is cached between runs.
# NORAMEDI_PGBACKREST_STATE_DIR=/var/lib/noramedi-pgbackrest

# How often `pgbackrest check` may actually run, in seconds. It is the only
# command that validates the whole archive_command -> repository path end to
# end, which is why it runs at all — but it FORCES A WAL SEGMENT SWITCH, so
# running it on every 15-minute tick would manufacture segments purely for
# monitoring. Default 3600 = at most once an hour; the cached result is
# reported in between.
# NORAMEDI_PGBACKREST_CHECK_MIN_INTERVAL_SECONDS=3600

# Per-command timeout, seconds. Bounds each pgbackrest/psql call so a hung
# repository cannot stall the writer past the unit's TimeoutStartSec.
# NORAMEDI_PGBACKREST_CMD_TIMEOUT=60

# ── Off-host proof ───────────────────────────────────────────────────────
# The marker written by noramedi-pgbackrest-restore-drill.sh --record after a
# PASSING drill sourced from repo2. It is the ONLY thing that can move the
# reported off-host state from "unproven" to "yes".
#
# This indirection is deliberate. A configured remote repository proves
# nothing: a remote-looking hostname can still resolve to this machine, and an
# existing repository is not evidence that anything is recoverable from it.
# The status writer can therefore never emit "yes" from its own observations.
# NORAMEDI_PGBACKREST_OFFHOST_PROOF=/var/lib/noramedi/pitr-offhost-proof.json

# How long a restore proof stays valid, in hours. Default 720 = 30 days: after
# that the off-host claim decays back to "unproven" and must be re-earned by
# running the drill again. A proof that never expires would let a single
# successful restore in January justify a green off-host tick in December.
# NORAMEDI_PGBACKREST_OFFHOST_PROOF_MAX_AGE_HOURS=720

# PostgreSQL OS superuser to delegate to. pgBackRest must run as the cluster
# owner and refuses to run as root.
# NORAMEDI_PG_SUPERUSER=postgres

# Any malformed value above (non-integer, zero) makes the script exit 2 rather
# than being ignored — the same fail-closed discipline the opscheck uses.
